# LLM provider configuration (copy to .env and fill in for a real backend).
# Loaded automatically by `run()` / the CLI when a `.env` file exists.
# Keys already present in the environment take precedence over this file.

# OpenAI-compatible endpoint (used when --provider openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini