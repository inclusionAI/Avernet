{
  "description": "Device connection information response.",
  "properties": {
    "type": {
      "description": "Connection type (local/remote)",
      "title": "Type",
      "type": "string"
    },
    "target": {
      "description": "Connection target (host:port)",
      "title": "Target",
      "type": "string"
    },
    "token": {
      "description": "Connection token",
      "title": "Token",
      "type": "string"
    },
    "engine_type": {
      "description": "Engine type",
      "title": "Engine Type",
      "type": "string"
    },
    "available": {
      "default": true,
      "description": "Whether the device is reachable",
      "title": "Available",
      "type": "boolean"
    },
    "message": {
      "default": "",
      "description": "Human-readable status message when unavailable",
      "title": "Message",
      "type": "string"
    },
    "url": {
      "default": "",
      "description": "Connection URL (HTTP or WebSocket, depending on connection mode)",
      "title": "Url",
      "type": "string"
    },
    "a2a_base_url": {
      "default": "",
      "description": "Authoritative HTTP base of the device's A2A face (agent-card / /rpc), issued by BaaS in ws-info. Empty string means the provider delivered no A2A address: callers fall back to existing behavior and must NOT derive or compose one (a relay ws URL implies no equivalent A2A face).",
      "title": "A2A Base Url",
      "type": "string"
    }
  },
  "required": [
    "type",
    "target",
    "token",
    "engine_type"
  ],
  "title": "DeviceConnectionResponse",
  "type": "object"
}
