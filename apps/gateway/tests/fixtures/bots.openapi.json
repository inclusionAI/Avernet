      "AgentDetail": {
        "properties": {
          "agentId": {
            "type": "string",
            "title": "Agentid",
            "description": "Stable Bot metadata identifier.",
            "examples": [
              "17"
            ]
          },
          "platform": {
            "type": "string",
            "title": "Platform",
            "description": "Registered source platform code.",
            "examples": [
              "example-platform"
            ]
          },
          "agentName": {
            "type": "string",
            "title": "Agentname",
            "description": "Bot display name.",
            "examples": [
              "Support Bot"
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Bot description.",
            "examples": [
              "Answers support questions."
            ]
          },
          "creatorNo": {
            "type": "string",
            "title": "Creatorno",
            "description": "Bot creator identifier.",
            "examples": [
              "creator-17"
            ]
          },
          "aiWorkNo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aiworkno",
            "description": "Bound digital employee identifier, when present.",
            "examples": [
              "AI00000124"
            ]
          },
          "agentCode": {
            "type": "string",
            "title": "Agentcode",
            "description": "AgentPass agent code.",
            "examples": [
              "agent-17"
            ]
          },
          "agentPlatform": {
            "type": "string",
            "title": "Agentplatform",
            "description": "Registered source platform code.",
            "examples": [
              "example-platform"
            ]
          },
          "agentFramework": {
            "type": "string",
            "title": "Agentframework",
            "description": "Bot engine type.",
            "examples": [
              "openclaw"
            ]
          },
          "modelList": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Modellist",
            "description": "Models available from a runnable Bot instance.",
            "examples": [
              [
                "provider/model"
              ]
            ]
          },
          "mcpDetailList": {
            "items": {
              "$ref": "#/components/schemas/McpDetail"
            },
            "type": "array",
            "title": "Mcpdetaillist",
            "description": "Remote MCP capabilities of this version."
          },
          "skillList": {
            "items": {
              "$ref": "#/components/schemas/SkillDetail"
            },
            "type": "array",
            "title": "Skilllist",
            "description": "Complete active Skill packages of this version."
          },
          "cliLis": {
            "items": {
              "$ref": "#/components/schemas/CliDetail"
            },
            "type": "array",
            "title": "Clilis",
            "description": "Shared AgentPass CLI capabilities. The field spelling follows the platform contract."
          },
          "queriedVersionStatus": {
            "type": "string",
            "title": "Queriedversionstatus",
            "description": "Selected configuration version: draft, published, or applying.",
            "examples": [
              "draft"
            ]
          }
        },
        "type": "object",
        "required": [
          "agentId",
          "platform",
          "agentName",
          "creatorNo",
          "agentCode",
          "agentPlatform",
          "agentFramework",
          "modelList",
          "mcpDetailList",
          "skillList",
          "cliLis",
          "queriedVersionStatus"
        ],
        "title": "AgentDetail",
        "description": "Service Bot metadata and the capabilities of the selected version."
      },
