server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location /auth/ { proxy_pass ${BCS_AUTH_UPSTREAM}; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }
  location /openapi/v1/bots/work-order-notifications { proxy_pass ${TEAMCLAW_ADMIN_UPSTREAM}; proxy_set_header Host $host; }
  location /openapi/v1/bots/work-orders { proxy_pass ${TEAMCLAW_ADMIN_UPSTREAM}; proxy_set_header Host $host; }
  location /openapi/v1/bots/spaces { proxy_pass ${TEAMCLAW_ADMIN_UPSTREAM}; proxy_set_header Host $host; }
  # BBS public APIs are owned by the Gateway route in pre-production. Keep these
  # narrower locations before the generic collaboration task upstream.
  location /openapi/v1/collaboration/tasks/bbs/ { proxy_pass ${TEAMCLAW_GATEWAY_UPSTREAM}; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; }
  location ~ ^/openapi/v1/collaboration/tasks/bots/[^/]+/bbs(?:/|$) { proxy_pass ${TEAMCLAW_GATEWAY_UPSTREAM}; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; }
  # RSI Bot requests reuse this authenticated Gateway; no direct Evolution route.
