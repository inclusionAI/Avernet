{
  "name": "@avernet/clawevolve",
  "version": "0.1.0",
  "description": "Public ClawEvolve core for Avernet",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/create-module": {
      "types": "./dist/server/create-module.d.ts",
      "import": "./dist/server/create-module.js"
    },
    "./server/routes/evolve": {
      "types": "./dist/server/routes/evolve.d.ts",
      "import": "./dist/server/routes/evolve.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./runtime/create-runtime-module": {
      "types": "./dist/runtime/create-runtime-module.d.ts",
      "import": "./dist/runtime/create-runtime-module.js"
    },
    "./server/services/evolve/command": {
      "types": "./dist/server/services/evolve/command.d.ts",
      "import": "./dist/server/services/evolve/command.js"
    },
    "./server/services/evolve/artifact-ref": {
      "types": "./dist/server/services/evolve/artifact-ref.d.ts",
      "import": "./dist/server/services/evolve/artifact-ref.js"
    },
    "./server/services/evolve/artifact-storage": {
      "types": "./dist/server/services/evolve/artifact-storage.d.ts",
      "import": "./dist/server/services/evolve/artifact-storage.js"
    },
    "./server/services/evolve/artifact-url": {
      "types": "./dist/server/services/evolve/artifact-url.d.ts",
      "import": "./dist/server/services/evolve/artifact-url.js"
    },
    "./server/services/evolve/plan-source-contract": {
      "types": "./dist/server/services/evolve/plan-source-contract.d.ts",
      "import": "./dist/server/services/evolve/plan-source-contract.js"
    },
    "./server/services/evolve/task-registry": {
      "types": "./dist/server/services/evolve/task-registry.d.ts",
      "import": "./dist/server/services/evolve/task-registry.js"
    },
    "./server/services/evolve/task-start": {
      "types": "./dist/server/services/evolve/task-start.d.ts",
      "import": "./dist/server/services/evolve/task-start.js"
    },
    "./server/services/evolve/run-analysis-timeout": {
      "types": "./dist/server/services/evolve/run-analysis-timeout.d.ts",
      "import": "./dist/server/services/evolve/run-analysis-timeout.js"
    },
    "./server/services/evolve/task-source-service": {
      "types": "./dist/server/services/evolve/task-source-service.d.ts",
      "import": "./dist/server/services/evolve/task-source-service.js"
    },
    "./server/services/evolve/adapters/insight-plan-source-adapter": {
      "types": "./dist/server/services/evolve/adapters/insight-plan-source-adapter.d.ts",
      "import": "./dist/server/services/evolve/adapters/insight-plan-source-adapter.js"
    },
    "./server/ports": {
      "types": "./dist/server/ports/index.d.ts",
      "import": "./dist/server/ports/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "bash scripts/check-public-boundary.sh && tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "express": "^5.2.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  },
  "peerDependencies": {
    "express": "^5.2.1"
  }
}
