{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/TaskSpec.json",
  "title": "TaskSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "goal",
    "deliverables",
    "constraints",
    "success_criteria",
    "required_capabilities",
    "required_knowledge",
    "required_resources",
    "risk_level",
    "unknowns",
    "subtasks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tsk_[a-zA-Z0-9_-]+$"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_knowledge": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "required_resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "subtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "objective"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "default": []
    },
    "source_prompt": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "default": {}
    }
  }
}
