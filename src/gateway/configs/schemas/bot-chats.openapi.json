          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/openapi/v1/bot-chats/{trace_id}": {
      "get": {
        "tags": [
          "bot-chats-open"
        ],
        "summary": "Get Open Session",
        "description": "Get an exact trace and observation tree without owner filtering.",
        "operationId": "get_open_session_api_v1_open_bot_chats__trace_id__get",
        "parameters": [
          {
            "name": "trace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trace Id"
            }
