        <mxCell id="rules" value="&lt;b&gt;Relay 不变量&lt;/b&gt;　① 当前棒完成后直接 DONE，后棒不得修改前序/根节点运行事实　② Graph 生成下一节点 ID，每轮最多一个下一棒节点　③ /search 仅搜索、不感知任务 ID、不写图　④ DISPATCH_RESULT 是决策事实，/dispatch 是真实交付　⑤ gaps=[] → 任务 DONE；超轮次/恢复耗尽 → HUNG" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7ED;strokeColor=#ED7D31;strokeWidth=2;align=left;fontSize=15;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="1250" width="2380" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="recovery" value="恢复侧路：relay_turn 过期 → TaskHarness.resume_relay_turn → [RESUME_RELAY]；只恢复当前棒 authority/lease，不重做已完成业务工作，不做中心化父子收敛" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#E4DFEC;strokeColor=#8064A2;strokeWidth=2;align=left;fontSize=14;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="1390" width="2380" height="55" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
