{
  "raw_user_config": {
    "app": {
      "description": "Custom SOFAPy application",
      "local_debug": true,
      "title": "My SOFAPy App",
      "version": "1.0.0"
    },
    "baas": {
      "api_base_url": "${BASS_URL:-}",
      "deploy_runtime": "ack",
      "template_uuid": "${BAAS_TEMPLATE_ID:-}",
      "tenant": "${BAAS_TENANT:-}"
    },
    "bcn": {
      "base_url": "${BCS_URL}",
      "base_url_pre": "${BCS_URL}",
      "provider_admin_token_pre": "${BCS_ADMIN_TOKEN}",
      "provider_admin_token_prod": "${BCS_ADMIN_TOKEN}",
      "provider_id_pre": "${BCS_PROVIDER_ID}",
      "provider_id_prod": "${BCS_PROVIDER_ID}"
    },
    "bcs": {
      "base_url": "${BCS_URL:-}",
      "operator_subjects": [],
      "timeout": 10,
      "user_path": "/auth/user"
    },
    "bcsfuse": {
      "base_url": "${BCS_FUSE_URL:-}"
    },
    "bot_config_manifest": {
      "content_store_dir": "./data/manifest_content",
      "fetch_transport_allowlist": [],
      "teclaw_platform_managed": false
    },
    "bot_oss_config": {
      "bucket_name": "agentclaw",
      "endpoint": ""
    },
    "business": {
      "retry_count": 3,
      "timeout": 30
    },
    "cache": {
      "redis_url": "${REDIS_URL:-}"
    },
    "cors": {
      "allow_origin_regex": [],
      "allow_origins": [
        "http://localhost",
        "http://localhost:3000",
        "http://localhost:8080",
        "http://localhost:8888"
      ]
    },
    "daas_device_config": {
      "adapter_service_port": 20003
    },
    "database": {
      "backend": "mysql",
      "create_schema": false,
      "url": "${DATABASE_URL}"
    },
    "desktop_bot_periodic_scan": {
      "apply_owner_whitelist": [],
      "enabled": false,
      "global_dry_run": false
    },
    "device_allocation": {
      "max_devices_per_entity": 5,
      "mode": "multi"
    },
    "device_provider": "local",
    "dormant": {
      "dry_run": true
    },
    "ecb": {
      "base_url": "${ECB_URL:-}"
    },
    "features": {
      "enable_cache": true,
      "enable_metrics": false,
      "max_connections": 100
    },
    "gateway": {
      "base_url": "${GATEWAY_URL:-}",
      "base_url_pre": "${GATEWAY_URL_PRE:-}"
    },
    "git_sync": {
      "bolt_shared_dir_name": "bolt_shared",
      "enable_oss_sync": true,
      "enable_skill_sync": false
    },
    "health_check": {
      "bcs_url": "http://localhost:21000"
    },
    "llm": {
      "base_url": "${LLM_BASE_URL:-}",
      "model": "${LLM_BALANCED_MODEL:-glm-5.2}",
      "secret_name": "LLM_AUTH_TOKEN",
      "timeout_ms": "${LLM_DEFAULT_TIMEOUT_MS:-180000}"
    },
    "mcp": {
      "registry_config_path": ""
    },
    "nas_mount_root": "./data/nas",
    "object_storage": {
      "backend": "fs",
      "fs_root": "./data/objstore",
      "s3": {
        "bucket": "",
        "endpoint": "",
        "region": "us-east-1",
        "secure": true
      }
    },
    "openclaw": {
      "skills_repo_url": ""
    },
    "oss_mount_root": "./data/oss",
    "outbound_rules": {
      "header_rules": [
        {
          "action": "replace",
          "domains": [
            "${MODEL_API:-}"
          ],
          "header_name": "Authorization",
          "placeholder": "${API-KEY}",
          "value": "${MODEL_KEY:-}"
        }
      ]
    },
    "secret": {
      "env_prefix": ""
    },
    "skill_scan": {
      "auth_app_key": "agentclaw",
      "enable_scheduled_scan": false,
      "enabled": false,
      "max_concurrent_scans": 3,
      "mist_mode": "dev",
      "scan_interval_hours": 1,
      "storage_dir": "./data/skills_scan"
    },
    "task_queue_worker": {
      "enabled": true
    },
    "whitelist": {
      "operator_names": []
    },
    "workspace": {
      "aicoding_root": "./data/workspace/aicoding",
      "claude_code_root": "./data/workspace/claude_code",
      "hermes_root": "./data/workspace/hermes",
      "openclaw_root": "./data/workspace/openclaw"
    }
  },
  "typed": {
    "aix": {
      "preview_url": ""
    },
    "baas": {
      "api_base_url": "${BASS_URL:-}",
      "api_base_url_pre": "http://localhost:8888",
      "default_ttl_minutes": 10080,
      "desktop_template_uuid": "",
      "desktop_ttl_minutes": 0,
      "eval_template_uuid": "",
      "personal_bot_template_uuid": "",
      "teclaw_template_uuid": "",
      "template_uuid": "${BAAS_TEMPLATE_ID:-}",
      "tenant": "${BAAS_TENANT:-}"
    },
    "bcn": {
      "base_url": "${BCS_URL}",
      "base_url_pre": "${BCS_URL}",
      "provider_admin_token_pre": "${BCS_ADMIN_TOKEN}",
      "provider_admin_token_prod": "${BCS_ADMIN_TOKEN}",
      "provider_id_pre": "${BCS_PROVIDER_ID}",
      "provider_id_prod": "${BCS_PROVIDER_ID}"
    },
    "bcsfuse": {
      "base_url": "${BCS_FUSE_URL:-}",
      "base_url_pre": "",
      "raw": {
        "base_url": "${BCS_FUSE_URL:-}"
      }
    },
    "bot_chat": {
      "langfuse_base_url": "",
      "langfuse_public_key": "",
      "langfuse_secret_key": ""
    },
    "bot_oss": {
      "bucket_name": "agentclaw",
      "endpoint": "",
      "secret_name": ""
    },
    "cors": {
      "allow_origin_regex": [],
      "allow_origins": [
        "http://localhost",
        "http://localhost:3000",
        "http://localhost:8080",
        "http://localhost:8888"
      ]
    },
    "deploy_runtime": {
      "runtime": "ack"
    },
    "desktop_bot_periodic_scan": {
      "apply_owner_whitelist": [],
      "enabled": false,
      "global_dry_run": false
    },
    "device_allocation": {
      "arca_legacy_tenant": "legacy",
      "max_devices_per_entity": 5,
      "mode": "multi"
    },
    "device_provider": {
      "default_provider": "local"
    },
    "dormant_config": {
      "dry_run": true
    },
    "dormant_notify": {
      "action_link_pattern": ""
    },
    "ecb": {
      "base_url": "${ECB_URL:-}",
      "base_url_pre": ""
    },
    "gateway": {
      "base_url": "${GATEWAY_URL:-}",
      "base_url_pre": "${GATEWAY_URL_PRE:-}"
    },
    "http_client_pool": {
      "defaults": {
        "http2": false,
        "keepalive_expiry": 5.0,
        "max_connections": 100,
        "max_keepalive_connections": 20
      },
      "overrides": {}
    },
    "kb": {
      "base_url": "",
      "function_name": "",
      "instance_name": "",
      "interface_name": "",
      "token": ""
    },
    "llm_harness": {
      "base_url": "${LLM_BASE_URL:-}",
      "secret_name": "LLM_AUTH_TOKEN"
    },
    "masa_agent_eval": {
      "base_url": "http://localhost:8080",
      "base_url_pre": "http://localhost:8080"
    },
    "oss_to_nas": {
      "nas_root": "./data/nas",
      "oss_root": "./data/oss"
    },
    "secret_names": {
      "aicoding_theta_master_key": "",
      "aiworkbench_repo_url": "",
      "dormant_internal_token": "",
      "gateway_principal_signing_key": "gateway_principal_signing_key",
      "skill_center_internal_token": ""
    },
    "skill_scan": {
      "auth_app_key": "agentclaw",
      "auth_app_secret": "",
      "auth_endpoint": "",
      "enable_scheduled_scan": false,
      "enabled": false,
      "env": "prod",
      "git_download_dir": "/home/admin/logs/tmp/sec/code",
      "max_concurrent_scans": 3,
      "mist_mode": "dev",
      "scan_interval_hours": 1,
      "scan_interval_minutes": 0,
      "storage_dir": "./data/skills_scan"
    },
    "task_queue": {
      "app": "agentclaw"
    },
    "task_queue_worker": {
      "batch_size": 10,
      "enabled": true,
      "lease_seconds": 60,
      "max_concurrency": 10,
      "poll_interval_seconds": 2.0,
      "poll_jitter_seconds": 0.5,
      "retry_backoff_max_seconds": 60.0,
      "retry_backoff_min_seconds": 1.0
    },
    "whitelist": {
      "operator_names": []
    },
    "workspace": {
      "aicoding_root": "<CWD>/data/workspace/aicoding",
      "claude_code_root": "<CWD>/data/workspace/claude_code",
      "claude_code_session_root": "/home/admin/.claude",
      "hermes_root": "<CWD>/data/workspace/hermes",
      "openclaw_root": "<CWD>/data/workspace/openclaw"
    },
    "workspace_hosting": {
      "access_key": "",
      "access_secret": "",
      "admin_member_staff_ids": [],
      "aixcore_base_url": "",
      "aixcore_base_url_pre": "",
      "base_url": "",
      "tenant": "default",
      "timeout": 30
    },
    "yuque": {
      "user_api": ""
    }
  }
}
