{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ResourcePack.json",
  "title": "ResourcePack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resources",
    "mount_instructions"
  ],
  "properties": {
    "resources": {
      "type": "array",
      "items": {
        "$ref": "ResourceRef.json"
      },
      "default": []
    },
    "mount_instructions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
