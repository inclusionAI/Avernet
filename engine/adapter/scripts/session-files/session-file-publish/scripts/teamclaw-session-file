#!/usr/bin/env python3
"""Publish an Engine workspace file; standalone Python 3 standard library only."""

import argparse
import http.client
import ipaddress
import json
import os
import sys
import time
from pathlib import PurePosixPath, PureWindowsPath
from urllib.parse import urlencode, urlsplit

DEFAULT_ENGINE_URL = "http://127.0.0.1:20003"
MAX_RESPONSE = 65536
TIMEOUT_SECONDS = 30


class Failure(Exception):
    def __init__(self, code, exit_code, http_status=None):
        self.code = code
        self.exit_code = exit_code
        self.http_status = http_status


class Parser(argparse.ArgumentParser):
    def error(self, message):
        # COSEC: argparse errors can echo credential-bearing user arguments.
        raise Failure("invalid_arguments", 2)


def endpoint(raw):
    """Return a numeric loopback host; never resolve an untrusted DNS name."""
    try:
        # COSEC: reject URL normalization, userinfo, paths, queries and fragments.
        if any(ord(char) <= 32 or ord(char) == 127 for char in raw):
            raise ValueError
        parsed = urlsplit(raw)
        if (parsed.scheme != "http" or not parsed.netloc or parsed.username is not None
                or parsed.password is not None or parsed.path not in ("", "/")
                or "?" in raw or "#" in raw or "%" in raw or "\\" in raw):
            raise ValueError
        host = parsed.hostname
        if host == "localhost":
            host = "127.0.0.1"
        address = ipaddress.ip_address(host)
        if not address.is_loopback:
            raise ValueError
        port = parsed.port if parsed.port is not None else 80
        if not 1 <= port <= 65535 or parsed.netloc.endswith(":"):
            raise ValueError
        return str(address), port
    except (TypeError, ValueError):
        raise Failure("invalid_engine_url", 2) from None


def validate_session_key(session_key):
    # COSEC: reject ambiguous identities without normalizing the trusted key.
    if (not session_key or session_key != session_key.strip()
            or session_key.lower() in ("current", "latest", "default")
            or any(ord(char) < 32 or 127 <= ord(char) <= 159 for char in session_key)):
        raise Failure("invalid_session_key", 2)


def resolve_session_key(explicit, environment):
    runtime = environment.get("HITL_SESSION_KEY")
    if runtime is not None:
        validate_session_key(runtime)
    if explicit is not None:
        validate_session_key(explicit)
    # COSEC: runtime context is authoritative; never fall back after rejection.
    if runtime is not None and explicit is not None and runtime != explicit:
        raise Failure("session_key_mismatch", 2)
    if runtime is None and explicit is None:
        raise Failure("missing_session_key", 2)
    return runtime if runtime is not None else explicit


def validate_arguments(path, session_key):
    # COSEC: lexical checks only; Engine owns filesystem/symlink containment.
    if (not path or PurePosixPath(path).is_absolute() or PureWindowsPath(path).drive
            or "\\" in path or ".." in path.split("/")
            or str(PurePosixPath(path)) == "."
            or any(ord(char) < 32 or ord(char) == 127 for char in path)):
        raise Failure("invalid_arguments", 2)
    validate_session_key(session_key)


def view_from_response(raw):
    try:
        value = json.loads(raw)
        if not isinstance(value, dict):
            raise TypeError
        if (any(not isinstance(value.get(key), str) or not value[key]
                for key in ("resource_id", "display_name"))
                or type(value.get("size_bytes")) is not int or value["size_bytes"] < 0
                or value.get("availability") != "ready"
                or "uploaded_at" not in value
                or (value["uploaded_at"] is not None and not isinstance(value["uploaded_at"], str))):
            raise ValueError
        # COSEC: only return contract metadata, never arbitrary extra fields.
        view = {key: value[key] for key in (
            "resource_id", "display_name", "size_bytes", "availability", "uploaded_at")}
        if value.get("creator_type") not in (None, "bot", "user"):
            raise ValueError
        if value.get("created_at") is not None and not isinstance(value["created_at"], str):
            raise ValueError
        if value.get("creator_name") is not None and not isinstance(value["creator_name"], str):
            raise ValueError("invalid_response")
        for key in ("creator_type", "creator_name", "created_at"):
            if key in value:
                view[key] = value[key]
        return view
    except (TypeError, ValueError, UnicodeError, RecursionError):
        raise Failure("invalid_response", 5) from None


def log_event(event, method="POST", **metadata):
    print(json.dumps(dict(system="engine", direction="out", operation="publish", event=event,
                          method=method, path="/api/session-files", **metadata),
                     sort_keys=True), file=sys.stderr)


def verify_registration(host, port, session_key, view, context):
    started = time.monotonic()
    log_event("verification_request", method="GET", **context,
              resource_id=view["resource_id"], http_status=None, elapsed_ms=0)
    # COSEC: reuse the validated numeric loopback endpoint, with no credentials,
    # proxies or redirects. A failed verification must never repeat the POST.
    connection = http.client.HTTPConnection(host, port, timeout=TIMEOUT_SECONDS)
    status = None
    try:
        connection.request("GET", "/api/session-files?" + urlencode({"sessionKey": session_key}),
                           headers={"Accept": "application/json"})
        response = connection.getresponse()
        status = response.status
        if not 200 <= status < 300:
            raise Failure("verification_failed", 6, status)
        raw = response.read(MAX_RESPONSE + 1)
        if len(raw) > MAX_RESPONSE:
            raise Failure("verification_failed", 6, status)
        listing = json.loads(raw)
        if not isinstance(listing, dict) or not isinstance(listing.get("files"), list):
            raise ValueError
        for item in listing["files"]:
            if not isinstance(item, dict) or not isinstance(item.get("resource_id"), str):
                raise ValueError
        matches = [item for item in listing["files"] if item["resource_id"] == view["resource_id"]]
        if not matches or any(item.get("availability") != "ready" for item in matches):
            raise Failure("registration_not_confirmed", 6, status)
        if len(matches) != 1:
            raise ValueError
        confirmed = view_from_response(json.dumps(matches[0]))
        log_event("verification_success", method="GET", **context, **confirmed,
                  http_status=status, elapsed_ms=round((time.monotonic() - started) * 1000))
        return confirmed
    except (Failure, TypeError, ValueError, UnicodeError, RecursionError,
            OSError, http.client.HTTPException) as exc:
        code = "verification_failed"
        if isinstance(exc, Failure) and exc.code == "registration_not_confirmed":
            code = exc.code
        log_event("verification_failure", method="GET", **context, resource_id=view["resource_id"],
                  code=code, http_status=status,
                  elapsed_ms=round((time.monotonic() - started) * 1000))
        raise Failure(code, 6, status) from None
    finally:
        connection.close()


def publish(path, session_key, engine_url):
    validate_arguments(path, session_key)
    host, port = endpoint(engine_url)
    started = time.monotonic()
    context = {"sessionKey": session_key, "workspace_relative_path": path}
    log_event("request", **context, http_status=None, elapsed_ms=0)
    # COSEC: numeric loopback only; HTTPConnection ignores proxy/auth environment
    # and never follows redirects. Do not read Backend/Gateway credentials.
    connection = http.client.HTTPConnection(host, port, timeout=TIMEOUT_SECONDS)
    status = None
    try:
        connection.request("POST", "/api/session-files?" + urlencode({"sessionKey": session_key}),
                           body=json.dumps({"workspace_relative_path": path}).encode("utf-8"),
                           headers={"Content-Type": "application/json", "Accept": "application/json"})
        response = connection.getresponse()
        status = response.status
        if 300 <= status < 400:
            raise Failure("redirect_rejected", 4, status)
        if not 200 <= status < 300:
            # COSEC: never read/echo arbitrary HTTP errors, reasons or Location.
            raise Failure("engine_http_error", 4, status)
        raw = response.read(MAX_RESPONSE + 1)
        if len(raw) > MAX_RESPONSE:
            raise Failure("invalid_response", 5)
        view = view_from_response(raw)
        log_event("success", **context, **view, http_status=status,
                  elapsed_ms=round((time.monotonic() - started) * 1000))
        confirmed = verify_registration(host, port, session_key, view, context)
        log_event("published", **context, **confirmed, http_status=status,
                  elapsed_ms=round((time.monotonic() - started) * 1000))
        return confirmed
    except Failure as exc:
        if exc.http_status is None and exc.exit_code != 6:
            exc.http_status = status
        raise
    except TimeoutError:
        raise Failure("engine_timeout", 3, status) from None
    except (OSError, http.client.HTTPException):
        raise Failure("engine_unreachable", 3, status) from None
    finally:
        connection.close()


def main(argv=None):
    parser = Parser(prog="teamclaw-session-file", description=__doc__, allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True, parser_class=Parser)
    command = commands.add_parser("publish", allow_abbrev=False)
    command.add_argument("workspace_relative_path")
    command.add_argument("--session-key")
    command.add_argument("--engine-url", default=DEFAULT_ENGINE_URL)
    started = time.monotonic()
    args = None
    try:
        args = parser.parse_args(argv)
        args.session_key = resolve_session_key(args.session_key, os.environ)
        view = publish(args.workspace_relative_path, args.session_key, args.engine_url)
        result, exit_code = {"ok": True, "code": "published", "file": view}, 0
    except Failure as exc:
        result, exit_code = {"ok": False, "code": exc.code}, exc.exit_code
        if exc.http_status is not None:
            result["http_status"] = exc.http_status
        if exc.exit_code == 6:
            result["registration_may_have_succeeded"] = True
            result["message"] = ("Registration may have succeeded, but list verification did not confirm it. "
                                 "No automatic retry was attempted.")
        context = {}
        if args is not None and exc.exit_code != 2:
            context = {"sessionKey": args.session_key,
                       "workspace_relative_path": args.workspace_relative_path}
        log_event("failure", **context, code=exc.code, http_status=exc.http_status,
                  elapsed_ms=round((time.monotonic() - started) * 1000))
    print(json.dumps(result, ensure_ascii=True, sort_keys=True))
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
