# Engine profile: community | corp | test
ENGINE_PROFILE=community
# DEPLOY_PROFILE is accepted as fallback for compatibility.
# DEPLOY_PROFILE=community

# --- Engine selection (community) ---
# The shipped engine.json default is "openclaw", whose gateway server is NOT part
# of the open-source export, so it cannot run out of the box. For a working
# community setup select claude_code (its Node gateway IS vendored under
# community/claude_code_gateway/). These vars are NOT auto-loaded — either
# `export` them or pass inline, e.g.  `CHAT_ENGINE=claude_code python start.py`.
CHAT_ENGINE=claude_code
# claude_code connects to the vendored Node relay gateway (default shown).
CLAUDE_CODE_RELAY_URL=ws://127.0.0.1:18900
# Your own Anthropic access: an API key for the SDK bridge, or a logged-in
# `claude` CLI (then set CLAUDE_BRIDGE=cli on the gateway). No key ships here.
ANTHROPIC_API_KEY=

# Runtime
RUNTIME_MODE=local
AGENTCLAW_ENV=dev

# Auth gate / zero-check
ZERO_CHECK_ENABLED=true
ZERO_CHECK_URL=
ZERO_CHECK_TIMEOUT_MS=500

# Optional skills-repo sync. Empty disables automatic sync.
# Use SKILLS_REPO_META_URL for a full metadata JSON URL, or provide a
# template with {env} and set AGENTCLAW_ENV=dev/pre/prod in deployment.
SKILLS_REPO_META_URL=
SKILLS_REPO_META_URL_TEMPLATE=

# Optional Langfuse tracing. Empty disables tracing/no-op.
EVAL_ENABLED=true
EVAL_LANGFUSE_PUBLIC_KEY=
EVAL_LANGFUSE_SECRET_KEY=
EVAL_LANGFUSE_HOST=

# Corp-only DIMA plugin settings; not required in community profile.
DIMA_BASE_URL=
DIMA_ACCESS_KEY=
DIMA_ACCESS_SECRET=
