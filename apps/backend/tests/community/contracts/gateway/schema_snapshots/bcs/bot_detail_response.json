{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BCS Bot Detail Response",
  "description": "Contract schema for BCS /bots/{uuid} responses",
  "type": "object",
  "required": ["actor_kind", "bot_uuid", "capabilities", "status"],
  "properties": {
    "actor_kind": {"type": "string"},
    "bot_uuid": {"type": "string"},
    "capabilities": {
      "type": "object",
      "required": ["name", "summary", "hidden", "visibility", "skills"],
      "properties": {
        "name": {"type": "string"},
        "summary": {"type": "string"},
        "hidden": {"type": "boolean"},
        "visibility": {"type": "string"},
        "domains": {"type": "array"},
        "scopes": {"type": "array"},
        "skills": {"type": "array"},
        "binding_channels": {"type": "object"}
      }
    },
    "created_by": {"type": "string"},
    "dynamic_status": {"type": "object"},
    "env": {"type": "string"},
    "status": {"type": "string"}
  }
}