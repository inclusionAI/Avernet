<?xml version="1.0" encoding="UTF-8"?>
<!--
  业务接入示例。真实应用是 SOFABoot 应用，grpc / protobuf / SOFA 由基座提供；
  这里为了能脱离基座编译和跑测试，把 grpc 依赖声明为 provided，不引入 SOFA。
  SOFABoot 下的发布写法见 README 和 DemoWiring 的注释。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>bcn.a2a</groupId>
        <artifactId>bcn-a2a-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>bcn-a2a-demo</artifactId>

    <dependencies>
        <dependency>
            <groupId>bcn.a2a</groupId>
            <artifactId>bcn-a2a-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>bcn.a2a</groupId>
            <artifactId>bcn-a2a-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
