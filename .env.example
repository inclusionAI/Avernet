# Copy this file to .env.local when you need local overrides.
# .env.local is git-ignored. Keep real API keys only in .env.local.

# ====== Common local defaults ======

# BCS HTTP/WebSocket port. Docker uses the same value inside the container and
# on the host.
BCS_PORT=21000

# Frontend port. Docker uses the same value inside the container and on the host.
FRONTEND_PORT=8000

# Local mock display name when SERVER_ENV=local.
BCS_MOCK_USER_NICK_NAME="Turing"

# ====== Singlebox model config ======

# The interactive ./scripts/singlebox.sh flow asks for one of:
#   mock   - Use fixed-format replies from the local Mock Model Server.
#   manual - Use OPENCLAW_OPENAI_* values below.
#   home   - Import model fields from ~/.openclaw/openclaw.json.
# Set this value to skip the prompt in automated runs.
# SINGLEBOX_MODEL_CONFIG_MODE=mock
# SINGLEBOX_MOCK_MODEL_PORT=18080

# ====== Optional: real model replies in manual mode ======

# Priority:
# 1. Complete OPENCLAW_OPENAI_* below.
# 2. Host OpenClaw config at ${OPENCLAW_HOST_CONFIG_DIR}/openclaw.json.
# If neither is available, BCS/frontend/onboard still start, but bots cannot
# produce real model replies.

# OPENCLAW_OPENAI_PROVIDER_ID=openai-compatible
# OPENCLAW_OPENAI_BASE_URL=https://api.openai.com/v1
# OPENCLAW_OPENAI_API_KEY=
# OPENCLAW_OPENAI_MODEL_ID=
# OPENCLAW_OPENAI_MODEL_NAME=
# OPENCLAW_OPENAI_MODEL_API=openai-completions

# OPENCLAW_HOST_CONFIG_DIR=/absolute/path/to/.openclaw
# If this directory does not exist, Docker Compose may create an empty one.

# ====== Optional: public mirrors ======

# Use public mirror registries for npm/PyPI/rustup/cargo when downloads are slow.
# USE_CN_MIRROR=1

# ====== BCSFuse (context fusion & semantic search) ======

# Dev mode (SQLite+Faiss) requires an embedding endpoint for semantic search.
# Reuses OPENCLAW_OPENAI_BASE_URL / OPENCLAW_OPENAI_API_KEY by default.
# Override only if your embedding endpoint differs:
# EMBEDDING_BASE_URL=
# EMBEDDING_AUTH_TOKEN=
# If using a non-default embedding model, also set:
# EMBEDDING_MODEL=           # default: Qwen3-Embedding-8B
# EMBEDDING_DIMENSION=       # default: 4096 (must match your model's output dim)

# Full configuration: src/bcsfuse/.env.example
