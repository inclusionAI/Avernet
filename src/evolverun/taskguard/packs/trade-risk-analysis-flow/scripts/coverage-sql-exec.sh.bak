#!/usr/bin/env bash
# coverage-sql-exec.sh — 覆盖分析 SQL 执行脚本
# 执行 Step 1~4: 参数校验 → 权限检查 → 建样本表 → 关联稽核宽表
# 输出 JSON 给下游 coverage-analysis 节点消费
# ============================================
# 错误处理：确保任何错误都输出 JSON 到 stdout
# ============================================
error_exit_handler() {
  local exit_code=$?
  local last_command=$BASH_COMMAND
  
  # 如果已经输出过 JSON（权限检查失败的情况），直接退出
  if [ "${JSON_OUTPUTTED:-false}" = "true" ]; then
    exit $exit_code
  fi
  
  # 生成 JSON 错误信息到 stdout 供 Workflow 引擎解析
  cat <<EOF
{
  "success": false,
  "error": "脚本执行失败: exit_code=$exit_code, command='$last_command'。请查看 stderr 日志获取详细信息。",
  "errorDetail": {
    "exitCode": $exit_code,
    "failedCommand": "$last_command",
    "debugLogLocation": "/tmp/coverage-sql-exec-${FLOW_ID:-$$}.log"
  },
  "permissionChecked": false,
  "sampleTable": "",
  "allinTable": "",
  "sampleCount": 0,
  "matchedCount": 0,
  "riskCount": 0,
  "extractedParams": {
    "uid": "${ALIPAY_UID:-}",
    "tradeNo": "${TRADE_NO:-}",
    "digitalPoiId": "${DIGITAL_POI_ID:-}",
    "sampleScope": "${SAMPLE_SCOPE:-}",
    "dateRange": "${DATE_RANGE:-}",
    "tables": "${TABLES:-}"
  }
}
EOF
  exit $exit_code
}

trap error_exit_handler ERR

set -euo pipefail

# 调试日志重定向
DEBUG_LOG="/tmp/coverage-sql-exec-${FLOW_ID:-$$}.log"
exec 2> >(tee -a "$DEBUG_LOG" >&2)
echo "=== 调试日志开始: $(date) ===" >> "$DEBUG_LOG"
echo "环境变量:" >> "$DEBUG_LOG"
env | grep -E 'ALIPAY_|SAMPLE_|DATE_|SCENE_|TABLES|PROJECT_' >> "$DEBUG_LOG" 2>/dev/null || true

###############################################################################
# 参数
###############################################################################
# 环境变量:
#   ALIPAY_UID       - 支付宝用户ID
#   TRADE_NO         - 交易号
#   DIGITAL_POI_ID   - 门店ID(逗号分隔)
#   SAMPLE_SCOPE     - 样本口径SQL
#   DATE_RANGE       - 时间范围 (如 2026-04-08)
#   DATE_START       - 开始日期 (yyyyMMdd)
#   DATE_END         - 结束日期 (yyyyMMdd)
#   TABLES           - 涉及表名(逗号分隔)
#   RISK_TYPE        - 风险类型
#   SCENE_ABBR       - 场景名称拼音缩写 (如 xtyxxfx)
#   PROJECT_ID       - Dataphin 项目ID (默认 410894)

PROJECT_ID="${PROJECT_ID:-410894}"
SCENE_ABBR="${SCENE_ABBR:-scene}"
DATE_START="${DATE_START:-}"
DATE_END="${DATE_END:-}"

# 中间表名
SAMPLE_TABLE="alipaybipub_dev.sc_fzb_scene_trd_${SCENE_ABBR}_${DATE_START}"
ALLIN_TABLE="alipaybipub_dev.sc_fzb_scene_trd_allin_${SCENE_ABBR}_${DATE_START}"

###############################################################################
# 辅助函数
###############################################################################
log() { 
  # 日志输出到 stderr，避免污染 stdout（Workflow 引擎要求 stdout 必须是纯 JSON）
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >&2
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$DEBUG_LOG" 2>/dev/null || true
}

# 执行 SQL（通过 Dataphin MCP）
# 参数: $1=SQL语句
# 输出: query_id
run_sql() {
  local sql="$1"
  # 转义 SQL 中的特殊字符用于 JSON
  local sql_escaped
  sql_escaped=$(python3 -c "import json; print(json.dumps('$sql'))" 2>/dev/null || \
                python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$sql" 2>/dev/null)
  # 用 python 构造 JSON 参数避免 shell 转义地狱
  local args_json
  args_json=$(python3 -c "
import json, sys
print(json.dumps({'project_id': ${PROJECT_ID}, 'sql_query': sys.argv[1]}))
" "$sql" 2>/dev/null)

  local result
  result=$(mcporter call mcp.ant.rpc.dpagent.dataprocess.run_sql_query \
    --args "$args_json" \
    --output json 2>&1) || {
    log "❌ SQL 提交失败: $result"
    return 1
  }

  # 提取 query_id
  local query_id
  query_id=$(echo "$result" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    print(d.get('data', {}).get('queryId', ''))
except:
    print('')
" 2>/dev/null || echo "")

  if [ -z "$query_id" ]; then
    log "❌ 无法获取 query_id"
    return 1
  fi
  echo "$query_id"
}

# 轮询 SQL 执行状态
# 参数: $1=query_id, $2=max_wait_seconds(默认600)
# 返回: 0=成功 1=失败 2=超时
poll_sql() {
  local query_id="$1"
  local max_wait="${2:-600}"
  local elapsed=0
  # 指数退避: 排队60s → 执行初期30s → 后期10s
  local wait_seq=(60 60 30 30 30 20 20 20 20 20 10 10 10 10 10 10 10 10 10 10)

  for wait_sec in "${wait_seq[@]}"; do
    if [ "$elapsed" -ge "$max_wait" ]; then
      log "⏰ SQL 超时 (${max_wait}s)"
      return 2
    fi

    local args_json
    args_json=$(python3 -c "
import json
print(json.dumps({'query_id': '${query_id}'}))
" 2>/dev/null)

    local status_result
    status_result=$(mcporter call mcp.ant.rpc.dpagent.dataprocess.query_sql_status \
      --args "$args_json" \
      --output json 2>&1) || {
      log "⚠️ 查询状态失败, 继续轮询"
      sleep "$wait_sec"
      elapsed=$((elapsed + wait_sec))
      continue
    }

    local status
    status=$(echo "$status_result" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    print(d.get('data', {}).get('status', 'UNKNOWN'))
except:
    print('UNKNOWN')
" 2>/dev/null || echo "UNKNOWN")

    case "$status" in
      SUCCESS) log "✅ SQL 执行成功 (query_id=$query_id)"; return 0 ;;
      FAILED)  log "❌ SQL 执行失败 (query_id=$query_id)"; return 1 ;;
      RUNNING|SUBMITTED|PENDING)
        log "⏳ SQL 状态: $status, 等待 ${wait_sec}s..."
        sleep "$wait_sec"
        elapsed=$((elapsed + wait_sec))
        ;;
      *)
        log "❓ 未知状态: $status, 等待 ${wait_sec}s..."
        sleep "$wait_sec"
        elapsed=$((elapsed + wait_sec))
        ;;
    esac
  done
  log "⏰ SQL 超时 (轮询序列结束)"
  return 2
}

# 执行 SQL 并等待完成
# 参数: $1=SQL语句, $2=max_wait_seconds(默认600)
exec_sql() {
  local sql="$1"
  local max_wait="${2:-600}"
  log "📤 提交 SQL..."
  local query_id
  query_id=$(run_sql "$sql") || return 1
  log "📋 query_id=$query_id"
  poll_sql "$query_id" "$max_wait"
}

# 获取 SQL 查询结果 (JSON)
get_sql_result() {
  local query_id="$1"
  local args_json
  args_json=$(python3 -c "
import json
print(json.dumps({'query_id': '${query_id}', 'response_format': 'CONCISE'}))
" 2>/dev/null)
  mcporter call mcp.ant.rpc.dpagent.dataprocess.query_sql_result \
    --args "$args_json" \
    --output json 2>&1
}

# 从 SQL 查询结果的 JSON 中提取第一个数值
# Dataphin 返回格式: data.results[0].data = [["col1"], ["val1"]] (TABLE格式)
extract_count() {
  local json_data="$1"
  local col_idx="${2:-0}"
  
  log "  DEBUG extract_count: col_idx=$col_idx, json_preview=${json_data:0:200}"
  
  local result
  result=$(echo "$json_data" | python3 << PYEOF
import json, sys
try:
    d = json.load(sys.stdin)
    results = d.get('data', {}).get('results', [])
    if results and len(results) > 0:
        result = results[0]
        rows = result.get('data', [])
        # TABLE格式: [["col"], ["val"]]
        if len(rows) > 1 and len(rows[1]) > int($col_idx):
            val = rows[1][int($col_idx)]
            print(int(val) if str(val).isdigit() else 0)
        elif len(rows) == 1 and len(rows[0]) > int($col_idx):
            val = rows[0][int($col_idx)]
            print(int(val) if str(val).isdigit() else 0)
        else:
            print(0)
    else:
        print(0)
except Exception as e:
    sys.stderr.write(f"Error in extract_count: {e}\\n")
    print(0)
PYEOF
) 2>> "$DEBUG_LOG"
  
  log "  DEBUG extract_count result=$result"
  echo "$result"
}

###############################################################################
# 参数预处理
###############################################################################

# TABLES 可能是 JSON 数组格式 ["table1", "table2"]，转换为逗号分隔的普通字符串
if [ -n "${TABLES:-}" ]; then
  # 尝试解析 JSON 数组
  CLEAN_TABLES=$(echo "$TABLES" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    if isinstance(data, list):
        print(','.join(data))
    else:
        print(data)
except:
    print(sys.stdin.read().strip())
" 2>/dev/null)
  if [ -n "$CLEAN_TABLES" ]; then
    TABLES="$CLEAN_TABLES"
    log "📋 表名列表(已解析): $TABLES"
  fi
fi

###############################################################################
# 主流程
###############################################################################

log "=== 覆盖分析 SQL 执行开始 ==="
log "场景: $SCENE_ABBR | 日期: $DATE_START ~ $DATE_END"
log "样本表: $SAMPLE_TABLE"
log "宽表: $ALLIN_TABLE"

###############################################################################
# Step 2: 样本表权限检查
###############################################################################
log "--- Step 2: 样本表权限检查 ---"

PERMISSION_OK="true"
PERMISSION_DETAIL=""

if [ -n "${TABLES:-}" ]; then
  IFS=',' read -ra TABLE_LIST <<< "$TABLES"
  for tbl in "${TABLE_LIST[@]}"; do
    # 用指定日期分区做简单查询验证权限
    CHECK_SQL="SELECT 1 FROM ${tbl} WHERE dt = '${DATE_START}' LIMIT 1;"
    if exec_sql "$CHECK_SQL" 120; then
      log "✅ 表 $tbl 可访问"
    else
      log "❌ 表 $tbl 无权限或不存在"
      PERMISSION_OK="false"
      PERMISSION_DETAIL="${PERMISSION_DETAIL}表 ${tbl} 无权限; "
    fi
  done
fi

if [ "$PERMISSION_OK" = "false" ]; then
  log "❌ 权限检查未通过, 终止执行"
  JSON_OUTPUTTED="true"  # 标记已输出 JSON，避免 trap 重复输出
  cat <<EOF
{
  "success": false,
  "error": "权限检查失败: ${PERMISSION_DETAIL}",
  "permissionChecked": false,
  "sampleTable": "",
  "allinTable": "",
  "sampleCount": 0,
  "matchedCount": 0,
  "riskCount": 0,
  "extractedParams": {
    "uid": "${ALIPAY_UID:-}",
    "tradeNo": "${TRADE_NO:-}",
    "digitalPoiId": "${DIGITAL_POI_ID:-}",
    "sampleScope": "${SAMPLE_SCOPE:-}",
    "dateRange": "${DATE_RANGE:-}",
    "tables": "${TABLES:-}"
  }
}
EOF
  exit 1
fi

###############################################################################
# Step 3: 样本交易提取 (CREATE TABLE AS)
###############################################################################
log "--- Step 3: 样本交易提取 ---"

# SAMPLE_SCOPE 可能是:
#   1. 完整 SELECT 语句 (以 SELECT 开头) → 作为子查询
#   2. 表名+条件 (如 table WHERE ...) → 直接 FROM
if echo "$SAMPLE_SCOPE" | grep -qi '^\s*SELECT'; then
  # 完整 SELECT → 作为子查询，只取 trade_no，dt 由常量填充
  STEP3_SQL="DROP TABLE IF EXISTS ${SAMPLE_TABLE}; CREATE TABLE IF NOT EXISTS ${SAMPLE_TABLE} AS SELECT sub.trade_no, '${DATE_START}' AS dt FROM (${SAMPLE_SCOPE}) sub;"
else
  # 表名+条件 → 直接 FROM
  STEP3_SQL="DROP TABLE IF EXISTS ${SAMPLE_TABLE}; CREATE TABLE IF NOT EXISTS ${SAMPLE_TABLE} AS SELECT trade_no, dt FROM ${SAMPLE_SCOPE};"
fi

log "📋 Step3 SQL: ${STEP3_SQL:0:200}..."

if ! exec_sql "$STEP3_SQL" 600; then
  log "❌ 样本交易提取失败"
  JSON_OUTPUTTED="true"  # 标记已输出 JSON，避免 trap 重复输出
  cat <<EOF
{
  "success": false,
  "error": "Step 3 样本交易提取SQL执行失败",
  "permissionChecked": true,
  "sampleTable": "${SAMPLE_TABLE}",
  "allinTable": "",
  "sampleCount": 0,
  "matchedCount": 0,
  "riskCount": 0
}
EOF
  exit 1
fi

# 验证数据量
COUNT_SQL="SELECT COUNT(*) AS cnt FROM ${SAMPLE_TABLE};"
SAMPLE_COUNT=0
QUERY_STATUS="unknown"
COUNT_RESULT_JSON=""

log "📤 提交计数 SQL: ${COUNT_SQL}"
query_id=$(run_sql "$COUNT_SQL") || {
  log "❌ 计数 SQL 提交失败: $?"
  QUERY_STATUS="submit_failed"
}

if [ -n "${query_id:-}" ]; then
  log "📋 计数 query_id=${query_id}"
  if poll_sql "$query_id" 120; then
    QUERY_STATUS="success"
    COUNT_RESULT_JSON=$(get_sql_result "$query_id")
    log "📄 计数结果 JSON 前500字: ${COUNT_RESULT_JSON:0:500}"
    SAMPLE_COUNT=$(extract_count "$COUNT_RESULT_JSON" 0)
    log "📊 extract_count 返回: ${SAMPLE_COUNT}"
  else
    QUERY_STATUS="poll_failed_$?"
    log "❌ 计数 SQL 轮询失败, status=${QUERY_STATUS}"
  fi
else
  log "❌ 未获取到 query_id"
fi

log "📊 样本交易数: ${SAMPLE_COUNT:-0} (状态: ${QUERY_STATUS})"

if [ "${SAMPLE_COUNT:-0}" -eq 0 ] 2>/dev/null || [ -z "${SAMPLE_COUNT}" ]; then
  log "⚠️ 样本提取结果为空"
  cat <<EOF
{
  "success": false,
  "error": "样本交易提取结果为空(0条记录)。调试信息: query_status=${QUERY_STATUS}, query_id=${query_id:-none}, sample_table=${SAMPLE_TABLE}, date_start=${DATE_START}, scene_abbr=${SCENE_ABBR}. 请检查样本口径SQL: ${SAMPLE_SCOPE:0:100}...",
  "permissionChecked": true,
  "sampleTable": "${SAMPLE_TABLE}",
  "allinTable": "",
  "sampleCount": 0,
  "matchedCount": 0,
  "riskCount": 0,
  "debugInfo": {
    "queryStatus": "${QUERY_STATUS}",
    "queryId": "${query_id:-}",
    "sampleTable": "${SAMPLE_TABLE}",
    "dateStart": "${DATE_START}",
    "sceneAbbr": "${SCENE_ABBR}",
    "step3Sql": "${STEP3_SQL:0:200}",
    "countResultJsonPreview": "${COUNT_RESULT_JSON:0:500}"
  }
}
EOF
  exit 1
fi

###############################################################################
# Step 4: 关联交易离线稽核信息 (LEFT JOIN 建宽表)
###############################################################################
log "--- Step 4: 关联离线稽核信息 ---"

STEP4_SQL="DROP TABLE IF EXISTS ${ALLIN_TABLE}; CREATE TABLE IF NOT EXISTS ${ALLIN_TABLE} AS SELECT t1.trade_no, t2.trade_buyer_id, t2.trade_seller_id, t2.uni_trade_no, t2.gmt_occur, t2.business_code, t2.busi_prod, t2.trade_total_amt, t2.total_dst_amt, t2.ali_dst_amt, t2.mer_sub_amt, t2.goods_title, t2.partner_id, t2.merchant_id, t2.secondary_merchant_id, t2.pid_smid, t2.merchant_type, t2.abnor_type_list, t1.dt FROM ${SAMPLE_TABLE} t1 LEFT JOIN (SELECT trade_no, trade_buyer_id, trade_seller_id, uni_trade_no, gmt_occur, business_code, busi_prod, trade_total_amt, total_dst_amt, ali_dst_amt, mer_sub_amt, goods_title, partner_id, merchant_id, secondary_merchant_id, pid_smid, merchant_type, abnor_type_list FROM antctu.adm_ctu_app_ekyt_abnor_allin_di WHERE dt BETWEEN '${DATE_START}' AND '${DATE_END}') t2 ON t1.trade_no = t2.trade_no;"

if ! exec_sql "$STEP4_SQL" 600; then
  log "❌ 关联稽核信息失败"
  JSON_OUTPUTTED="true"  # 标记已输出 JSON，避免 trap 重复输出
  cat <<EOF
{
  "success": false,
  "error": "Step 4 关联稽核信息SQL执行失败",
  "permissionChecked": true,
  "sampleTable": "${SAMPLE_TABLE}",
  "allinTable": "",
  "sampleCount": ${SAMPLE_COUNT:-0},
  "matchedCount": 0,
  "riskCount": 0
}
EOF
  exit 1
fi

# 统计关联率和风险覆盖
STATS_SQL="SELECT COUNT(*) AS total, SUM(CASE WHEN abnor_type_list IS NOT NULL AND abnor_type_list != '' THEN 1 ELSE 0 END) AS risk_cnt, SUM(CASE WHEN trade_buyer_id IS NOT NULL THEN 1 ELSE 0 END) AS matched_cnt FROM ${ALLIN_TABLE};"
TOTAL_COUNT="${SAMPLE_COUNT:-0}"
MATCHED_COUNT=0
RISK_COUNT=0

query_id=$(run_sql "$STATS_SQL") || {
  log "⚠️ 无法获取统计数据"
}
if [ -n "${query_id:-}" ]; then
  if poll_sql "$query_id" 120; then
    STATS_JSON=$(get_sql_result "$query_id")
    TOTAL_COUNT=$(extract_count "$STATS_JSON" 0)
    RISK_COUNT=$(extract_count "$STATS_JSON" 1)
    MATCHED_COUNT=$(extract_count "$STATS_JSON" 2)
  fi
fi

log "📊 样本总量: ${TOTAL_COUNT:-0}, 关联匹配: ${MATCHED_COUNT:-0}, 有风险标签: ${RISK_COUNT:-0}"

###############################################################################
# 输出结果 JSON
###############################################################################
log "=== 覆盖分析 SQL 执行完成 ==="

cat <<EOF
{
  "success": true,
  "permissionChecked": ${PERMISSION_OK},
  "sampleTable": "${SAMPLE_TABLE}",
  "allinTable": "${ALLIN_TABLE}",
  "sampleCount": ${TOTAL_COUNT:-0},
  "matchedCount": ${MATCHED_COUNT:-0},
  "riskCount": ${RISK_COUNT:-0},
  "dateStart": "${DATE_START}",
  "dateEnd": "${DATE_END}",
  "sceneAbbr": "${SCENE_ABBR}",
  "extractedParams": {
    "uid": "${ALIPAY_UID:-}",
    "tradeNo": "${TRADE_NO:-}",
    "digitalPoiId": "${DIGITAL_POI_ID:-}",
    "sampleScope": "${SAMPLE_SCOPE:-}",
    "dateRange": "${DATE_RANGE:-}",
    "tables": "${TABLES:-}"
  }
}
EOF