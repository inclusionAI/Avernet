{
  "meta": {
    "lastTouchedVersion": "2026.5.12",
    "lastTouchedAt": "2026-01-01T00:00:00.000Z"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "openai-compatible": {
        "baseUrl": "https://MODEL_PROVIDER_HOST/compatible-mode/v1",
        "apiKey": "Bearer ${API-KEY}",
        "auth": "api-key",
        "api": "openai-completions",
        "models": [
          {
            "id": "glm-5.2",
            "name": "glm-5.2",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ],
        "request": {
          "allowPrivateNetwork": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "imageMaxDimensionPx": 4096,
      "model": {
        "primary": "openai-compatible/glm-5.2"
      },
      "imageModel": {
        "primary": "openai-compatible/glm-5.2"
      },
      "models": {
        "openai-compatible/glm-5.2": {}
      },
      "compaction": { "mode": "safeguard" },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8,
        "archiveAfterMinutes": 5256000
      }
    }
  },
  "tools": {
    "alsoAllow": ["bcs_route"],
    "media": {
      "image": { "enabled": true, "maxBytes": 20971520 }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "logging": {
    "file": "/home/admin/logs/openclaw/openclaw.log",
    "level": "info",
    "maxFileBytes": 10485760
  },
  "skills": {
    "entries": { "acp-router": { "enabled": false } },
    "load": {
      "extraDirs": ["/home/admin/.openclaw/skills"],
      "watch": true,
      "watchDebounceMs": 250
    }
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {}
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "reset": { "mode": "idle", "idleMinutes": 5256000 }
  },
  "messages": {
    "groupChat": { "visibleReplies": "automatic" }
  },
  "discovery": {
    "mdns": { "mode": "off" },
    "wideArea": { "enabled": false }
  },
  "channels": {
    "bcs": {
      "enabled": true,
      "capabilities": {
        "summary": "OpenClaw bot",
        "domains": ["general"],
        "skills": ["general"],
        "scopes": ["production"]
      },
      "heartbeatIntervalMs": 60000,
      "reconnectIntervalMs": 5000,
      "connectionTimeoutMs": 30000
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "ack-openclaw"
    },
    "nodes": {
      "denyCommands": [
        "camera.snap", "camera.clip", "screen.record",
        "calendar.add", "contacts.add", "reminders.add"
      ]
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "/opt/openclawExt/openclaw-channel-bcn"
      ]
    },
    "entries": {
      "openclaw-channel-bcn": {
        "enabled": true
      }
    }
  }
}
