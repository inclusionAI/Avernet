<?xml version="1.0" encoding="UTF-8"?>
<!--
  A2A Agent Client 骨架（评审用）：按 AgentCard 调用任意标准 A2A Agent 的 Java 客户端。
  groupId / 包名为占位，实现时替换为公司坐标。
  依赖与服务端 A2A Agent Adapter 相同：只用 a2a-java 的 spec-grpc（protobuf 模型与 gRPC 桩），
  grpc / protobuf 由 SOFA 基座提供（provided），HTTP 使用 JDK 自带的 java.net.http.HttpClient，不引入其他 HTTP 库。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>a2a.agent</groupId>
    <artifactId>a2a-agent-client</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <a2a.version>1.4.0.Final</a2a.version>
        <grpc.version>1.81.0</grpc.version>
        <protobuf.version>4.35.0</protobuf.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- A2A 1.0 的 protobuf 模型与 gRPC 桩；连带引入 Gson（JSON-RPC 信封解析用） -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-spec-grpc</artifactId>
            <version>${a2a.version}</version>
        </dependency>

        <!-- 以下由 SOFA 基座提供；版本以基座为准（TODO(内部)：在基座 5.14.1 上确认） -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- ProtoJSON 编解码（HTTP+JSON / JSONRPC 两种绑定）。TODO(内部)：基座是否提供，否则改为 compile -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
            <version>${protobuf.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 测试：in-process gRPC 服务端 + JDK HttpServer 模拟 Agent -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
