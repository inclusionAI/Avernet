{
  "name": "@avernet-assets/bcs-panel",
  "version": "1.4.2",
  "description": "Prebuilt BCS side-panel components distributed as a UMD asset.",
  "main": "./dist/index.umd.js",
  "browser": "./dist/index.umd.js",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inclusionAI/Avernet.git",
    "directory": "src/bcs/assets/panel"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist/index.umd.js",
    "README.md",
    "PUBLISHING.md",
    "LICENSE",
    "UNDERCOVER_GAME.md",
    "assets"
  ],
  "scripts": {
    "build": "vite build",
    "test:umd": "node test/umd-contract.mjs",
    "typecheck": "tsc --noEmit",
    "scan:public": "node scripts/public-scan.mjs && node scripts/asset-scan.mjs",
    "verify": "npm run typecheck && npm run build && npm run test:umd && npm run test:focused && npm run test:integration && npm run test:visual && npm run scan:public",
    "prepack": "npm run verify",
    "test:focused": "node test/undercover-game/focused.mjs && node test/undercover-game/component-lifecycle.mjs && node test/undercover-game/public-result.mjs",
    "test:integration": "node test/undercover-game/integration-smoke.mjs && node test/shared-panels.mjs",
    "test:visual": "node test/undercover-game/visual-regression.mjs"
  },
  "dependencies": {
    "styled-components": "^6.0.7"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.1.0",
    "jsdom": "27.4.0"
  }
}
