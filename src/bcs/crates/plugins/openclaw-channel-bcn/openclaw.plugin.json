{
  "id": "openclaw-channel-bcn",
  "name": "BCS",
  "description": "BCS multi-bot collaboration channel plugin for OpenClaw.",
  "channels": ["bcs"],
  "channelConfigs": {
    "bcs": {
      "label": "BCS",
      "description": "Connect to BCS through WebSocket.",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "bcsUrl": {
            "type": "string"
          },
          "botId": {
            "type": "string"
          },
          "botName": {
            "type": "string"
          },
          "defaultAccount": {
            "type": "string"
          },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "bcsUrl": {
                  "type": "string"
                },
                "botId": {
                  "type": "string"
                },
                "botName": {
                  "type": "string"
                },
                "heartbeatIntervalMs": {
                  "type": "integer",
                  "minimum": 1000
                },
                "reconnectIntervalMs": {
                  "type": "integer",
                  "minimum": 1000
                },
                "connectionTimeoutMs": {
                  "type": "integer",
                  "minimum": 1000
                }
              }
            }
          },
          "heartbeatIntervalMs": {
            "type": "integer",
            "minimum": 1000
          },
          "reconnectIntervalMs": {
            "type": "integer",
            "minimum": 1000
          },
          "connectionTimeoutMs": {
            "type": "integer",
            "minimum": 1000
          }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "bcs_route",
      "bcs_assign_task",
      "bcs_send_task_message",
      "bcs_task_complete"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionCleanup": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pruneAfter", "intervalMinutes"],
        "properties": {
          "pruneAfter": {
            "type": ["string", "number"],
            "description": "Delete stale BCS OpenClaw sessions after this age, for example 2d."
          },
          "intervalMinutes": {
            "type": "number",
            "minimum": 1,
            "description": "How often the BCS plugin scans for stale sessions."
          }
        }
      }
    }
  }
}
