{
  "name": "@avernet-plugin/openclaw-channel-bcn",
  "version": "1.0.16",
  "description": "Installable OpenClaw BCS WebSocket channel plugin package.",
  "dependencies": {
    "ws": "^8.18.3"
  },
  "bundleDependencies": [
    "ws"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.15.3",
    "@eggjs/tsconfig": "^1.3.3",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.6.3",
    "@types/ws": "^8.5.0",
    "egg-bin": "^6.5.2",
    "eslint": "^8.49.0",
    "eslint-config-egg": "^14.0.0",
    "eslint-plugin-eggache": "^2.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^46.9.1",
    "eslint-plugin-node": "^11.1.0",
    "openclaw": "file:test/fixtures/openclaw-stub",
    "tshy": "^1.1.1",
    "tshy-after": "^1.0.0",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.28"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {},
  "scripts": {
    "build": "npm run prepublishOnly",
    "lint": "eslint src test --ext .ts",
    "pretest": "npm run lint -- --fix && npm run prepublishOnly",
    "test": "npm run test-local",
    "test-local": "egg-bin test",
    "cov": "egg-bin cov",
    "preci": "npm run prepublishOnly",
    "ci": "npm run lint && npm run cov && attw --pack",
    "prepublishOnly": "tshy && tshy-after"
  },
  "ci": {
    "versions": "20, 22",
    "cr": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inclusionAI/Avernet.git",
    "directory": "src/bcs/crates/plugins/openclaw-channel-bcn"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "openclaw.plugin.json"
  ],
  "type": "module",
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.3.28"
    },
    "extensions": [
      "./dist/esm/index.js"
    ],
    "setupEntry": "./dist/esm/setup-entry.js",
    "channel": {
      "id": "bcs",
      "label": "BCS",
      "selectionLabel": "BCS (WebSocket)",
      "docsPath": "/channels/bcs",
      "docsLabel": "bcs",
      "blurb": "Connect to BCS multi-bot collaboration platform via WebSocket.",
      "order": 100
    },
    "install": {
      "npmSpec": "@avernet-plugin/openclaw-channel-bcn",
      "localPath": "extensions/openclaw-channel-bcn",
      "defaultChoice": "npm"
    }
  },
  "tshy": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts",
      "./api": "./src/api.ts",
      "./setup-api": "./src/setup-api.ts",
      "./setup-entry": "./src/setup-entry.ts",
      "./core": "./src/core.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "source": "./src/index.ts",
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "source": "./src/index.ts",
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./api": {
      "import": {
        "source": "./src/api.ts",
        "types": "./dist/esm/api.d.ts",
        "default": "./dist/esm/api.js"
      },
      "require": {
        "source": "./src/api.ts",
        "types": "./dist/commonjs/api.d.ts",
        "default": "./dist/commonjs/api.js"
      }
    },
    "./setup-api": {
      "import": {
        "source": "./src/setup-api.ts",
        "types": "./dist/esm/setup-api.d.ts",
        "default": "./dist/esm/setup-api.js"
      },
      "require": {
        "source": "./src/setup-api.ts",
        "types": "./dist/commonjs/setup-api.d.ts",
        "default": "./dist/commonjs/setup-api.js"
      }
    },
    "./setup-entry": {
      "import": {
        "source": "./src/setup-entry.ts",
        "types": "./dist/esm/setup-entry.d.ts",
        "default": "./dist/esm/setup-entry.js"
      },
      "require": {
        "source": "./src/setup-entry.ts",
        "types": "./dist/commonjs/setup-entry.d.ts",
        "default": "./dist/commonjs/setup-entry.js"
      }
    },
    "./core": {
      "import": {
        "source": "./src/core.ts",
        "types": "./dist/esm/core.d.ts",
        "default": "./dist/esm/core.js"
      },
      "require": {
        "source": "./src/core.ts",
        "types": "./dist/commonjs/core.d.ts",
        "default": "./dist/commonjs/core.js"
      }
    }
  },
  "types": "./dist/commonjs/index.d.ts",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js"
}
