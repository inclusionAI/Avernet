{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "issue_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "growth_line_unclear",
          "latest_emphasis_missing",
          "label_vocabulary_invalid",
          "label_overlap",
          "content_cropped",
          "text_missing",
          "value_mismatch",
          "rendering_error",
          "blank_region_abnormal"
        ]
      },
      "uniqueItems": true
    }
  },
  "required": ["status", "issue_codes"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}},
      "then": {"properties": {"issue_codes": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "fail"}}},
      "then": {"properties": {"issue_codes": {"minItems": 1}}}
    }
  ]
}
