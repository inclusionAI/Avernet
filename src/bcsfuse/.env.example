# =============================================================================
# BCSFuse Open-Core Minimum Deployment Environment Template
# =============================================================================
# Copy this file to .env and configure for your environment
# NEVER commit .env with real credentials to version control

# =============================================================================
# Runtime Mode
# =============================================================================
export RUNTIME_MODE="runtime"
export BCSFUSE_PROVIDER_MODE="runtime"
export BCSFUSE_SERVER_HOST="127.0.0.1"
export BCSFUSE_SERVER_PORT="8765"
export SERVICE_HOST="0.0.0.0"
export SERVICE_PORT="8765"

# =============================================================================
# MySQL Configuration (REQUIRED for runtime mode)
# =============================================================================
export MYSQL_HOST="127.0.0.1"
export MYSQL_PORT="3306"
export MYSQL_USER="bcsfuse_user"
export MYSQL_PASSWORD="change_me"
export MYSQL_DATABASE="bcsfuse_oss"
export MYSQL_POOL_SIZE="15"

# =============================================================================
# Qdrant Configuration (Local Mode - No Server Required)
# =============================================================================
# CRITICAL: open-core uses Qdrant local mode (embedded)
# Do NOT configure QDRANT_URL or QDRANT_HOST for local mode
export VECTOR_BACKEND="qdrant_local"
export QDRANT_LOCAL_PATH="/tmp/bcsfuse_qdrant"
export QDRANT_COLLECTION_NAME="bcsfuse_profiles"

# =============================================================================
# LLM Configuration (REQUIRED for P0)
# =============================================================================
# Enable real LLM calls
export LLM_ENABLED="true"
export ENABLE_REAL_LLM="true"

# LLM endpoint (Anthropic-compatible)
# Replace with your actual LLM endpoint
export LLM_BASE_URL="change_me"
export LLM_AUTH_TOKEN="change_me"

# Models
export LLM_FAST_MODEL="GLM-4.7-Flash"
export LLM_BALANCED_MODEL="GLM-4.7-Flash"
export LLM_REASONING_MODEL="GLM-5"
export LLM_LONG_CONTEXT_MODEL="GLM-4.7-Flash"
export LLM_EXTRACTION_MODEL="GLM-4.7-Flash"

# Timeouts
export LLM_DEFAULT_TIMEOUT_MS="600000"
export LLM_REASONING_TIMEOUT_MS="600000"

# =============================================================================
# Embedding Configuration (REQUIRED for P0)
# =============================================================================
# CRITICAL: EMBEDDING_DIMENSION must be 4096 (Qwen3-Embedding-8B default)
# DO NOT change to 1024 or other values - will cause dimension mismatch
export ENABLE_REAL_EMBEDDING="true"
export EMBEDDING_ENABLED="true"

# Embedding endpoint (OpenAI-compatible)
# Replace with your actual embedding endpoint
export EMBEDDING_BASE_URL="change_me"
export EMBEDDING_AUTH_TOKEN="change_me"

# Model configuration
export EMBEDDING_MODEL="Qwen3-Embedding-8B"
export EMBEDDING_DIMENSION="4096"  # CRITICAL - MUST be 4096
export EMBEDDING_TIMEOUT_MS="30000"

# =============================================================================
# Reranker Configuration (Optional)
# =============================================================================
# Uncomment and configure if you have a reranker service
# export RERANKER_BASE_URL="change_me"
# export RERANKER_API_KEY="change_me"
# export RERANKER_MODEL="change_me"

# =============================================================================
# Authentication
# =============================================================================
# Simple token auth for open-core testing
export BCSFUSE_AUTH_TOKEN="dev-opencore-token"

# =============================================================================
# Logging
# =============================================================================
export LOG_LEVEL="INFO"
export LOG_ENABLE_FILE="false"

# =============================================================================
# Feature Flags (Production Defaults)
# =============================================================================
export ENABLE_VECTOR_AWARE_RECOMMENDATION="true"
export ENABLE_HYBRID_RETRIEVAL="true"
export ENABLE_DENSE_RETRIEVAL="true"
export ENABLE_SPARSE_RETRIEVAL="true"
export ENABLE_PROFILE_EMBEDDING_INDEX="true"
export ENABLE_G5_EXPERT_DIAGNOSIS="true"
export ENABLE_G5_STRUCTURED_RISK="true"
export ENABLE_G2_STRUCTURED_STANCE="true"
export ENABLE_G2_CONFLICT_DIMENSIONS="true"
export ENABLE_G1_SEMANTIC_MATCH="true"
export ENABLE_G1_PROFILE_RERANK="true"

# =============================================================================
# Worker Registry
# =============================================================================
export WORKER_REGISTRY_DATABASE_MODE="mysql"  # runtime=mysql, dev=sqlite

# =============================================================================
# Validation
# =============================================================================
# Run this after configuring:
#   source .env
#   echo "Configuration loaded"
#
# Verify:
#   - All change_me placeholders replaced
#   - EMBEDDING_DIMENSION=4096
#   - MySQL database exists
#   - LLM endpoint accessible
#   - Embedding endpoint accessible