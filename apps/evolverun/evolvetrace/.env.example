# Evolvetrace environment variables.
# Copy this file to .env and edit values. Environment variables override configs/application.yaml.

# Server
PORT=3001

# Comma-separated browser origins allowed to call the HTTP API.
# Example: https://avernet.example.com,https://preview.example.com
CORS_ALLOWED_ORIGINS=

# Database: sqlite | mysql | noop
DATABASE_MODE=sqlite
SQLITE_PATH=~/.evolvetrace/engine.db

# MySQL (only used when DATABASE_MODE=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=evolvetrace
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=evolvetrace

# Security
# Comma-separated list of admin user IDs
ADMIN_USER_IDS=admin

# Internal API Ed25519 public key (base64) for signature verification
EVOLVETRACE_INTERNAL_PUBLIC_KEY_B64=

# Node environment (dev | test | prod)
EVOLVETRACE_ENV=dev
