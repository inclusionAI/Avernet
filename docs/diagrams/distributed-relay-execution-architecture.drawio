        </mxCell>
        <mxCell id="init_graph" value="initialize_graph(TaskInfo)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;创建根 TaskNode；首棒 owner_bot RUNNING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontStyle=1;" vertex="1" parent="graph">
          <mxGeometry x="30" y="60" width="590" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="get_context" value="GET /api/v1/collaboration/tasks/{task_id}/context&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;→ TaskContext(spec, all_done_output, gaps)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#DDF3F5;strokeColor=#2A8C94;strokeWidth=2;fontStyle=1;" vertex="1" parent="graph">
          <mxGeometry x="30" y="180" width="590" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="report" value="POST /api/v1/collaboration/tasks/callback/report&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;EXECUTION_RESULT / PLAN_RESULT / DISPATCH_RESULT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontStyle=1;" vertex="1" parent="graph">
          <mxGeometry x="30" y="305" width="590" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="facts" value="Graph Facts&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;TaskSpec · RuntimeInfo · assignee · run_mode · status&lt;br&gt;前序节点事实不可被后棒回写&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#D9EAF7;strokeColor=#4F81BD;strokeWidth=2;" vertex="1" parent="graph">
          <mxGeometry x="30" y="435" width="285" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="lease" value="Relay Authority&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;relay_turn TTL · holder · event_id 幂等&lt;br&gt;单一当前棒写权限&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#E4DFEC;strokeColor=#8064A2;strokeWidth=2;" vertex="1" parent="graph">
          <mxGeometry x="335" y="435" width="285" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="trajectory" value="TaskTrajectory / Outbox&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;事实轨迹 · 可靠事件 · 可观测性&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#F2F2F2;strokeColor=#7F8C8D;strokeWidth=2;" vertex="1" parent="graph">
          <mxGeometry x="30" y="590" width="285" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="query_dash" value="内部查询&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;query_task_dashboard(task_id)&lt;br&gt;query node/runtime facts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#F2F2F2;strokeColor=#7F8C8D;strokeWidth=2;" vertex="1" parent="graph">
          <mxGeometry x="335" y="590" width="285" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="graph_rule" value="&lt;b&gt;唯一事实写入口&lt;/b&gt;&lt;br&gt;所有节点状态与运行事实统一经 TaskGraphService.report 更新" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#F4CCCC;strokeColor=#C00000;strokeWidth=2;fontStyle=1;" vertex="1" parent="graph">
          <mxGeometry x="30" y="725" width="590" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="skill" value="当前棒 Relay Bot + task-loop Skill" style="swimlane;startSize=40;rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;swimlaneFillColor=#D9EAF7;strokeColor=#4F81BD;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="760" height="840" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="1. 读取最新 TaskContext" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#DDF3F5;strokeColor=#2A8C94;strokeWidth=2;fontStyle=1;" vertex="1" parent="skill">
          <mxGeometry x="30" y="60" width="700" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="2. Gap 与能力准入匹配&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;TaskNode.task_spec + IDENTITY/职责 + 已激活 Skills + 可用工具&lt;br&gt;&lt;b&gt;角色覆盖 AND 工具能力覆盖&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontStyle=1;" vertex="1" parent="skill">
          <mxGeometry x="30" y="145" width="700" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="3. 执行本棒实际目标&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;匹配：actual_goal + output + acceptance_result&lt;br&gt;零匹配/工具不可用：DECLINED，不得用模型常识硬做&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#D9EAF7;strokeColor=#4F81BD;strokeWidth=2;fontStyle=1;" vertex="1" parent="skill">
          <mxGeometry x="30" y="270" width="700" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="4. 上报 EXECUTION_RESULT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontStyle=1;" vertex="1" parent="skill">
          <mxGeometry x="30" y="400" width="330" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="5. 重读上下文并计算新 gaps&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;all_done_output + 节点 acceptance_result → Skill 语义推理&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#DDF3F5;strokeColor=#2A8C94;strokeWidth=2;fontStyle=1;" vertex="1" parent="skill">
          <mxGeometry x="390" y="400" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="6. 上报 PLAN_RESULT&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;gaps=[] → 完成&lt;br&gt;gaps≠[] → exactly one next_task_spec&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontStyle=1;" vertex="1" parent="skill">
          <mxGeometry x="30" y="500" width="700" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="7. 构造 query → 搜索候选 → 决策模态&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;0: MISS · 1–2: HIT_SINGLE · ≥3: HIT_MULTI_BOTS&lt;br&gt;Skill 选择 driver_bot_id + next_relay_bots&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontStyle=1;" vertex="1" parent="skill">
          <mxGeometry x="30" y="605" width="700" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value="8. 上报 DISPATCH_RESULT → 调用 /dispatch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontStyle=1;" vertex="1" parent="skill">
          <mxGeometry x="30" y="725" width="700" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="delivery" value="任务搜推 · 派发 · 执行" style="swimlane;startSize=40;rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;swimlaneFillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1570" y="360" width="870" height="840" as="geometry"/>
        </mxCell>
        <mxCell id="search" value="TaskDispatcher / TaskSearch&lt;br&gt;&lt;b&gt;POST /api/v1/collaboration/tasks/search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;in: { query }&lt;br&gt;out: { candidates[{bot_uuid, bot_name?, bot_desc?, bot_type?, status?, recommend}], total }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontStyle=1;" vertex="1" parent="delivery">
          <mxGeometry x="30" y="60" width="810" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="decision" value="Skill 决策并上报&lt;br&gt;DISPATCH_RESULT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#E4DFEC;strokeColor=#8064A2;strokeWidth=2;fontStyle=1;" vertex="1" parent="delivery">
          <mxGeometry x="270" y="215" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="dispatch" value="TaskDispatcher&lt;br&gt;&lt;b&gt;POST /api/v1/collaboration/tasks/dispatch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;in: task_id, origin_node_id, target_node_id,&lt;br&gt;holder_id, relay_turn, dispatch_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontStyle=1;" vertex="1" parent="delivery">
          <mxGeometry x="30" y="325" width="810" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="single" value="HIT_SINGLE&lt;br&gt;&lt;b&gt;单 Bot Runner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;driver = only next relay bot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#D9EAF7;strokeColor=#4F81BD;strokeWidth=2;fontStyle=1;" vertex="1" parent="delivery">
          <mxGeometry x="30" y="485" width="245" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="group" value="HIT_MULTI_BOTS&lt;br&gt;&lt;b&gt;协作群 Runner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;driver + workers&lt;br&gt;Human observer&lt;br&gt;当前棒默认不入群&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#DDF3F5;strokeColor=#2A8C94;strokeWidth=2;fontStyle=1;" vertex="1" parent="delivery">
          <mxGeometry x="310" y="485" width="245" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="bbs" value="MISS&lt;br&gt;&lt;b&gt;BBS 执行模态&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;POST /bbs/claim&lt;br&gt;POST /bbs/result&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontStyle=1;" vertex="1" parent="delivery">
          <mxGeometry x="590" y="485" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="runner" value="TaskRunner 稳定能力&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;start_run · form_coop_group · get_group_session · resume_relay_turn&lt;br&gt;派发成功后目标节点才进入 RUNNING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontStyle=1;" vertex="1" parent="delivery">
          <mxGeometry x="30" y="640" width="810" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="nextbot" value="下一棒 Bot(s) 接棒&lt;br&gt;&lt;b&gt;重复同一 Relay Skill 闭环&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#F4CCCC;strokeColor=#C00000;strokeWidth=2;fontStyle=1;" vertex="1" parent="delivery">
