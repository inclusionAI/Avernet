# BCSFuse runtime environment variables
# Copy this file to /home/xhunter/avernet-deploy/bcsfuse.env
# Fill in the REPLACE_WITH_* values.

# ---- MySQL ----
MYSQL_HOST=rm-xxxxxxxxxxxxxxxx.mysql.cn-beijing.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USER=avernet_db
MYSQL_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD
MYSQL_DATABASE=avernet

# ---- Embedding ----
EMBEDDING_BASE_URL=https://ws-xxxxxxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_AUTH_TOKEN=REPLACE_WITH_EMBEDDING_AUTH_TOKEN
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_MS=30000

# ---- LLM ----
ENABLE_REAL_LLM=true
LLM_BASE_URL=https://ws-xxxxxxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_AUTH_TOKEN=REPLACE_WITH_LLM_AUTH_TOKEN
LLM_API_TYPE=openai
LLM_FAST_MODEL=glm-5.2
LLM_BALANCED_MODEL=glm-5.2
LLM_REASONING_MODEL=glm-5.2
LLM_LONG_CONTEXT_MODEL=glm-5.2
LLM_EXTRACTION_MODEL=glm-5.2
LLM_DEFAULT_TIMEOUT_MS=600000
LLM_REASONING_TIMEOUT_MS=600000
