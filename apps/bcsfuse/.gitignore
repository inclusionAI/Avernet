# Build artifacts
*.egg-info/
dist/
build/

# SQLite :memory: leak file
:memory:
# IDE
.idea/
.vscode/
*.swp
*.swo

# Sofapy demo reference files (not part of bcsfuse)
SOFADEMO*.md
sofapydemo/

# =============================================================================
# Environment files (may contain secrets)
# =============================================================================
# Ignore all .env files by default
.env
.env.local

# Ignore runtime environment files

# Ignore runtime directories
.runtime/

# Ignore real config files (contain real tokens/credentials)
.env.fusion.real
.env.*.local

# But keep example templates
!.env.example
!.env.*.example

# =============================================================================
# Sensitive data and local artifacts
# =============================================================================
# Local test results (may contain runtime data)
*.local.json
*.local.log

# Temporary local configs
*.local.env

# =============================================================================
# Test outputs and reports (generated during testing)
# =============================================================================
# Stress test reports
stress_test_*.txt
stress_test_output.log

# Test outputs
test_output*.log
test_report*.txt

# E2E startup logs
startup_e2e.log

# =============================================================================
# Secrets and tokens
# =============================================================================
# Real token files
.env.real_token
*.real_token

# =============================================================================
# Database temporary files
# =============================================================================
# SQLite WAL (Write-Ahead Logging) files
*.db-shm
*.db-wal

# =============================================================================
# Runtime data directories (generated, not source-controlled)
# =============================================================================
# Qdrant vector storage (runtime data)
qdrant_storage/

# Local data directory (runtime data)
data/

# =============================================================================
# Test data and results
# =============================================================================
# Test results in data directory
data/*_test_*.json
data/test_*.json
data/*validation*.json
data/*regression*.json
data/g2_test_result.json
data/prepub_*.json
data/capability_verify_debug/
# Test profiles directory
data/test_profiles/

# Root level test results
prepub_*.json

# P0 test outputs
p0_*_contract_*.json
p0_all_results_*.json

# =============================================================================
# Log directories
# =============================================================================
logs/
scripts/logs/

# =============================================================================
# Open-core documentation (local only, not tracked)
# =============================================================================
g9_response.json

