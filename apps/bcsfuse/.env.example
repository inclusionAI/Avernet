# =============================================================================
# BCSFuse Open-Core Minimum Deployment Environment Template
# =============================================================================
# Copy this file to .env and configure for your environment
# NEVER commit .env with real credentials to version control

# =============================================================================
# Runtime Mode
# =============================================================================
export RUNTIME_MODE="runtime"
export BCSFUSE_PROVIDER_MODE="runtime"
export BCSFUSE_SERVER_HOST="127.0.0.1"
export BCSFUSE_SERVER_PORT="8765"
export SERVICE_HOST="0.0.0.0"
export BCSFUSE_SERVER_WORKERS="2"
export BCSFUSE_SERVER_LIMIT_CONCURRENCY="256"
export BCSFUSE_SERVER_BACKLOG="2048"
export SERVICE_PORT="8765"

# =============================================================================
# MySQL Configuration (REQUIRED for runtime mode)
# =============================================================================
export MYSQL_HOST="127.0.0.1"
export MYSQL_PORT="3306"
export MYSQL_USER="bcsfuse_user"
export MYSQL_PASSWORD="change_me"
export MYSQL_DATABASE="bcsfuse_oss"
export MYSQL_POOL_SIZE="8"
export MYSQL_CONNECT_TIMEOUT="3"
export MYSQL_STARTUP_RETRY_ATTEMPTS="5"
export MYSQL_STARTUP_RETRY_INTERVAL_MS="250"

# =============================================================================
# Qdrant Configuration (Runtime Server - HA / no per-pod file lock)
# =============================================================================
# Runtime must use the shared Qdrant Server endpoints. Direct dev/dev_smoke can
# override QDRANT_MODE=local and configure the local development path.
export VECTOR_BACKEND="qdrant_server"
export QDRANT_MODE="server"
export QDRANT_URL="change_me"
export QDRANT_COLLECTION_NAME="bcsfuse_profiles"
export QDRANT_PREFER_GRPC="true"
export QDRANT_GRPC_PORT="6334"
export QDRANT_TIMEOUT_SECONDS="10"
# Provide a secret only when the Qdrant endpoint requires API-key authentication.
# export QDRANT_API_KEY="change_me"
# Production HA should isolate the keyword cluster from the dense cluster.
export QDRANT_KEYWORD_URL="change_me"
export QDRANT_KEYWORD_PREFER_GRPC="true"
export QDRANT_KEYWORD_GRPC_PORT="6334"
export QDRANT_KEYWORD_TIMEOUT_SECONDS="10"
# export QDRANT_KEYWORD_API_KEY="change_me"

# Payload-only final fallback snapshot. The durable lease owner publishes it by
# atomic replace; read-only replicas load but never race to overwrite it.
# Runtime requires an absolute path on a persistent volume, not /tmp or tmpfs.
export BCSFUSE_LITERAL_FALLBACK_SNAPSHOT_PATH="/var/lib/bcsfuse/literal_fallback_snapshot.json"

# =============================================================================
# LLM Configuration (REQUIRED for P0)
# =============================================================================
# Enable real LLM calls
export LLM_ENABLED="true"
export ENABLE_REAL_LLM="true"

# LLM endpoint (Anthropic-compatible)
# Replace with your actual LLM endpoint
export LLM_BASE_URL="change_me"
export LLM_AUTH_TOKEN="change_me"

# Models (configure to match your LLM provider)
export LLM_FAST_MODEL="change_me"
export LLM_BALANCED_MODEL="change_me"
export LLM_REASONING_MODEL="change_me"
export LLM_LONG_CONTEXT_MODEL="change_me"
export LLM_EXTRACTION_MODEL="change_me"

# Timeouts
export LLM_DEFAULT_TIMEOUT_MS="600000"
export LLM_REASONING_TIMEOUT_MS="600000"

# =============================================================================
# Embedding Configuration (REQUIRED for P0)
# =============================================================================
# EMBEDDING_DIMENSION must match the Qdrant collection dimension.
# A non-default dimension requires a full quality and capacity regression plus
# a complete vector reindex, not just a setting change.
export ENABLE_REAL_EMBEDDING="true"
export EMBEDDING_ENABLED="true"

# Embedding endpoint (OpenAI-compatible)
# Replace with your actual embedding endpoint
export EMBEDDING_BASE_URL="change_me"
export EMBEDDING_AUTH_TOKEN="change_me"

# Model configuration. The efficient runtime default is Qwen3-Embedding-4B
# at 1024 dimensions; this non-native dimension is requested explicitly.
export EMBEDDING_MODEL="Qwen3-Embedding-4B"
export EMBEDDING_DIMENSION="1024"  # MUST match the Qdrant collection dimension
# Known BCSFuse model dimensions:
# - Qwen3-Embedding-0.6B: 1024 (native)
# - Qwen3-Embedding-4B: 1024, 2048, 2560 (native)
# - Qwen3-Embedding-8B: 1024, 2048, 4096 (native)
# Keep request-dimensions enabled for the selected 4B/1024 profile. The
# provider rejects unsupported known dimensions and response-collection
# mismatch.
export EMBEDDING_REQUEST_DIMENSIONS="true"
export EMBEDDING_TIMEOUT_MS="30000"
export EMBEDDING_MAX_RETRIES="1"
export EMBEDDING_RETRY_BACKOFF_SECONDS="0.25"
export EMBEDDING_RETRY_BUDGET_MS="2000"

# Adaptive query-embedding batching. The capacity-validated profile uses four
# smaller parallel batches; keep it in sync with the upstream embedding quota.
# export EMBEDDING_QUERY_BATCH_MAX_WORKERS="4"
# export EMBEDDING_QUERY_BATCH_MAX_SIZE="16"
# export EMBEDDING_QUERY_BATCH_WAIT_SECONDS="0.05"
# export EMBEDDING_QUERY_BATCH_PEAK_WAIT_SECONDS="0.15"
# export EMBEDDING_QUERY_BATCH_PEAK_THRESHOLD="8"

# Process-local query-embedding failure protection
# Deployment YAML keys: embedding.circuit.failure_threshold and
# embedding.circuit.recovery_seconds
# export EMBEDDING_CIRCUIT_FAILURE_THRESHOLD="3"
# export EMBEDDING_CIRCUIT_RECOVERY_SECONDS="10"
# Cluster quota state. Deployment YAML keys are under embedding.quota.
# Runtime mode stores shared state in MySQL, while dev mode uses SQLite next to
# the vector database. EMBEDDING_QUOTA_MAX_CALLS_PER_MINUTE counts upstream
# provider calls (not unique queries), so embedding batches retain throughput.
# Set it to 0 to disable the proactive call-window admission.
# export EMBEDDING_QUOTA_RECOVERY_SECONDS="60"
# export EMBEDDING_QUOTA_MAX_CALLS_PER_MINUTE="30"
# export EMBEDDING_QUOTA_PERIOD_SECONDS="60"

# =============================================================================
# Reranker Configuration (Optional)
# =============================================================================
# Uncomment and configure if you have a reranker service
# export RERANKER_BASE_URL="change_me"
# export RERANKER_API_KEY="change_me"
# Process-local reranker failure protection
# export RERANKER_CIRCUIT_FAILURE_THRESHOLD="3"
# export RERANKER_CIRCUIT_RECOVERY_SECONDS="10"
# export RERANKER_MODEL="Qwen3-Reranker-4B"

# =============================================================================
# Authentication
# =============================================================================
# Simple token auth for open-core testing
export BCSFUSE_AUTH_TOKEN="dev-opencore-token"

# Enable only when BCSFuse is reachable exclusively through the authenticated
# gateway. This is loaded into auth.trust_gateway; route code never reads it.
export BCSFUSE_TRUST_GATEWAY="false"

# =============================================================================
# Logging
# =============================================================================
export LOG_LEVEL="INFO"
export LOG_ENABLE_FILE="false"

# =============================================================================
# Feature Flags (Production Defaults)
# =============================================================================
export ENABLE_VECTOR_AWARE_RECOMMENDATION="true"
export ENABLE_HYBRID_RETRIEVAL="true"
export ENABLE_DENSE_RETRIEVAL="true"
export ENABLE_SPARSE_RETRIEVAL="true"
export ENABLE_PROFILE_EMBEDDING_INDEX="true"
export ENABLE_G5_EXPERT_DIAGNOSIS="true"
export ENABLE_G5_STRUCTURED_RISK="true"
export ENABLE_G2_STRUCTURED_STANCE="true"
export ENABLE_G2_CONFLICT_DIMENSIONS="true"
export ENABLE_G1_SEMANTIC_MATCH="true"
export ENABLE_G1_PROFILE_RERANK="true"

# =============================================================================
# Worker Registry
# =============================================================================
export WORKER_REGISTRY_DATABASE_MODE="mysql"  # runtime=mysql, dev=sqlite

# =============================================================================
# Validation
# =============================================================================
# Run this after configuring:
#   source .env
#   echo "Configuration loaded"
#
# Verify:
#   - All change_me placeholders replaced
#   - EMBEDDING_DIMENSION=1024
#   - EMBEDDING_REQUEST_DIMENSIONS=true
#   - MySQL database exists
#   - LLM endpoint accessible
#   - Embedding endpoint accessible