# BCSFuse runtime environment variables
# Copy this file to your external deploy directory (e.g. /home/xhunter/avernet-deploy/bcsfuse.env)
# Fill in real values, then load it via Kubernetes ConfigMap/Secret.

# -----------------------------
# Database (Aliyun OB/RDS MySQL)
# -----------------------------
export MYSQL_HOST=rm-xxxxxxxxxxxxxxxx.mysql.cn-beijing.rds.aliyuncs.com
export MYSQL_PORT=3306
export MYSQL_USER=avernet_db
export MYSQL_PASSWORD=REPLACE_WITH_REAL_PASSWORD
export MYSQL_DATABASE=avernet

# -----------------------------
# Embedding (Aliyun Bailian / OpenAI-compatible)
# -----------------------------
export EMBEDDING_BASE_URL=https://ws-xxxxxxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
export EMBEDDING_AUTH_TOKEN=REPLACE_WITH_REAL_TOKEN
export EMBEDDING_MODEL=qwen3.7-text-embedding
export EMBEDDING_DIMENSION=1024
export EMBEDDING_TIMEOUT_MS=30000

# -----------------------------
# LLM (Aliyun Bailian / OpenAI-compatible)
# If you do not need LLM features, set ENABLE_REAL_LLM=false and remove LLM vars.
# -------------------------
export ENABLE_REAL_LLM=true
export LLM_BASE_URL=https://ws-xxxxxxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
export LLM_AUTH_TOKEN=REPLACE_WITH_REAL_TOKEN
export LLM_API_TYPE=openai
export LLM_FAST_MODEL=glm-5.2
export LLM_BALANCED_MODEL=glm-5.2
export LLM_REASONING_MODEL=glm-5.2
export LLM_LONG_CONTEXT_MODEL=glm-5.2
export LLM_EXTRACTION_MODEL=glm-5.2
export LLM_DEFAULT_TIMEOUT_MS=600000
export LLM_REASONING_TIMEOUT_MS=600000
