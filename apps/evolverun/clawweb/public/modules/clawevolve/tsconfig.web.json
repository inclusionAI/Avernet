{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "web/src",
    "outDir": "dist/web",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "web/src/**/*.ts",
    "web/src/**/*.tsx"
  ],
  "exclude": [
    "web/src/**/__tests__/**",
    "node_modules",
    "dist"
  ]
}
