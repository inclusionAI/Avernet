# Copy this file to .env.local when you need local overrides.
# .env.local is git-ignored. Keep real API keys only in .env.local.

# ====== Common local defaults ======

# BCS HTTP/WebSocket port. Docker uses the same value inside the container and
# on the host.
BCS_PORT=21000

# Frontend port. Docker uses the same value inside the container and on the host.
FRONTEND_PORT=8000

# Local mock display name when SERVER_ENV=local.
BCS_MOCK_USER_NICK_NAME="Turing"

# ====== Optional: real 5-bot model replies ======

# Priority:
# 1. Complete OPENCLAW_OPENAI_* below.
# 2. Host OpenClaw config at ${OPENCLAW_HOST_CONFIG_DIR}/openclaw.json.
# If neither is available, BCS/frontend/onboard still start, but bots cannot
# produce real model replies.

# OPENCLAW_OPENAI_BASE_URL=https://api.openai.com/v1
# OPENCLAW_OPENAI_API_KEY=
# OPENCLAW_OPENAI_MODEL_ID=

# OPENCLAW_HOST_CONFIG_DIR=/absolute/path/to/.openclaw
# If this directory does not exist, Docker Compose may create an empty one.

# ====== Optional: public mirrors ======

# Use public mirror registries for npm/PyPI/rustup/cargo when downloads are slow.
# USE_CN_MIRROR=1
