          },
          "spawn_round": {
            "type": "integer",
            "title": "Spawn Round"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "bot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bot Id"
          },
          "bot_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bot State"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "output": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentResultDetailDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "attempt_ledger": {
            "items": {
              "$ref": "#/components/schemas/AgentAttemptDetailDTO"
            },
            "type": "array",
            "title": "Attempt Ledger"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/AgentMessageDetailDTO"
            },
            "type": "array",
            "title": "Messages"
          },
          "authorization": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BotAuthorizationDTO"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "agent_id",
          "name",
          "kind",
          "status",
          "depth",
          "spawn_round",
          "idempotency_key",
          "attempts"
        ],
        "title": "AgentDetailDTO"
      },
      "AgentAttemptDetailDTO": {
        "properties": {
          "claim_epoch": {
            "type": "integer",
