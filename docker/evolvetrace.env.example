# Evolvetrace environment variables for ACK deployment.
# Copy this file to evolvetrace.env and replace all REPLACE_WITH_* placeholders.
#
# Required: set DATABASE_MODE=mysql to use the shared MySQL database.
# Optional: configure static asset serving, signature verification, and admin users.

# Server
PORT=3001

# Database: sqlite | mysql | noop
DATABASE_MODE=mysql

# MySQL (only used when DATABASE_MODE=mysql)
MYSQL_HOST=rm-xxxxxxxxxxxxxxxx.mysql.cn-beijing.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USER=REPLACE_WITH_REAL_MYSQL_USER
MYSQL_PASSWORD=REPLACE_WITH_REAL_MYSQL_PASSWORD
MYSQL_DATABASE=REPLACE_WITH_REAL_MYSQL_DATABASE

# Security
# Comma-separated list of admin user IDs. Leave empty to disable admin routes.
ADMIN_USER_IDS=

# Internal API Ed25519 public key (base64) for signature verification.
# Used by ClawMind / internal runs endpoints. Leave empty to skip verification.
EVOLVETRACE_INTERNAL_PUBLIC_KEY_B64=

# Node environment (dev | test | prod)
EVOLVETRACE_ENV=prod
