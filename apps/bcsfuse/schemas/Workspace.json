{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/Workspace.json",
  "title": "Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "task_id",
    "team_spec",
    "knowledge_mounts",
    "resource_mounts",
    "artifacts",
    "events",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^wsp_[a-zA-Z0-9_-]+$"
    },
    "task_id": {
      "type": "string"
    },
    "team_spec": {
      "$ref": "TeamSpec.json"
    },
    "knowledge_mounts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "resource_mounts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "at"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": "object",
            "default": {}
          }
        }
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "assembled",
        "handed_off",
        "closed"
      ]
    }
  }
}
