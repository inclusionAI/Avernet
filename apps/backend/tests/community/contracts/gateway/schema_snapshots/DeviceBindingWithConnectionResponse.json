{
  "$defs": {
    "DeviceBindingStatus": {
      "description": "Device binding status enumeration.",
      "enum": [
        "PENDING",
        "ACTIVE",
        "FAILED",
        "RELEASED"
      ],
      "title": "DeviceBindingStatus",
      "type": "string"
    },
    "DeviceConnectionResponse": {
      "description": "Device connection information response.",
      "properties": {
        "type": {
          "description": "Connection type (local/remote)",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "description": "Connection target (host:port)",
          "title": "Target",
          "type": "string"
        },
        "token": {
          "description": "Connection token",
          "title": "Token",
          "type": "string"
        },
        "engine_type": {
          "description": "Engine type",
          "title": "Engine Type",
          "type": "string"
        },
        "available": {
          "default": true,
          "description": "Whether the device is reachable",
          "title": "Available",
          "type": "boolean"
        },
        "message": {
          "default": "",
          "description": "Human-readable status message when unavailable",
          "title": "Message",
          "type": "string"
        },
        "url": {
          "default": "",
          "description": "HTTP base URL (plan-01 added; e.g. http://10.0.0.1:20010)",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "type",
        "target",
        "token",
        "engine_type"
      ],
      "title": "DeviceConnectionResponse",
      "type": "object"
    },
    "EntityType": {
      "description": "Entity type enumeration.",
      "enum": [
        "staff",
        "team",
        "proj"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "Env": {
      "description": "Environment enumeration.",
      "enum": [
        "dev",
        "pre",
        "prod"
      ],
      "title": "Env",
      "type": "string"
    }
  },
  "description": "Device binding with optional connection info.",
  "properties": {
    "id": {
      "description": "Binding ID",
      "title": "Id",
      "type": "integer"
    },
    "entity_id": {
      "description": "Entity ID (user/team)",
      "title": "Entity Id",
      "type": "string"
    },
    "entity_type": {
      "$ref": "#/$defs/EntityType",
      "description": "Entity type"
    },
    "device_id": {
      "description": "Device ID",
      "title": "Device Id",
      "type": "string"
    },
    "device_provider": {
      "description": "Device provider (local/arca/daas)",
      "title": "Device Provider",
      "type": "string"
    },
    "env": {
      "$ref": "#/$defs/Env",
      "description": "Environment"
    },
    "device_props": {
      "additionalProperties": true,
      "description": "Device properties",
      "title": "Device Props",
      "type": "object"
    },
    "status": {
      "$ref": "#/$defs/DeviceBindingStatus",
      "description": "Binding status"
    },
    "last_alive_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Last alive timestamp",
      "title": "Last Alive At"
    },
    "connection": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceConnectionResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Connection details"
    }
  },
  "required": [
    "id",
    "entity_id",
    "entity_type",
    "device_id",
    "device_provider",
    "env",
    "device_props",
    "status"
  ],
  "title": "DeviceBindingWithConnectionResponse",
  "type": "object"
}
