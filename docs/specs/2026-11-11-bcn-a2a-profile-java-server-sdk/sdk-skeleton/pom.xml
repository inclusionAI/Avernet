<?xml version="1.0" encoding="UTF-8"?>
<!--
  BCN A2A Java SDK 骨架（评审用）。
  groupId / 包名均为占位（待 Q1 确定），实现时统一替换。
  grpc / protobuf 的版本应跟随 SOFA 基座；这里先与 a2a-java 1.4.0.Final 对齐，接入基座时以基座 BOM 为准。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>bcn.a2a</groupId>
    <artifactId>bcn-a2a-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>bcn-a2a-sdk</module>
        <module>bcn-a2a-test</module>
        <module>bcn-a2a-demo</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <a2a.version>1.4.0.Final</a2a.version>
        <grpc.version>1.81.0</grpc.version>
        <protobuf.version>4.35.0</protobuf.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-spec</artifactId>
                <version>${a2a.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-spec-grpc</artifactId>
                <version>${a2a.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>bcn.a2a</groupId>
                <artifactId>bcn-a2a-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>bcn.a2a</groupId>
                <artifactId>bcn-a2a-test</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
