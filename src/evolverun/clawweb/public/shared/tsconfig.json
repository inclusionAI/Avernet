{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true
  },
  "include": [
    "server/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx"
  ],
  "exclude": [
    "**/__tests__/**",
    "node_modules",
    "dist"
  ]
}
