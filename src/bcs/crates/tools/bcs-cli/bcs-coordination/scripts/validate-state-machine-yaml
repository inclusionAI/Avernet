#!/usr/bin/env bash
set -euo pipefail

if ! command -v node >/dev/null 2>&1; then
  echo '{"valid":false,"errors":[{"code":"ENVIRONMENT","path":"$","message":"node is required"}]}' >&2
  exit 2
fi
if ! command -v openclaw >/dev/null 2>&1; then
  echo '{"valid":false,"errors":[{"code":"ENVIRONMENT","path":"$","message":"openclaw is required"}]}' >&2
  exit 2
fi

openclaw_bin="$(command -v openclaw)"
if command -v mise >/dev/null 2>&1; then
  mise_openclaw_bin="$(mise which openclaw 2>/dev/null || true)"
  if [ -n "$mise_openclaw_bin" ] && [ -e "$mise_openclaw_bin" ]; then
    openclaw_bin="$mise_openclaw_bin"
  fi
fi
openclaw_real="$(node -e 'console.log(require("fs").realpathSync(process.argv[1]))' "$openclaw_bin")"
openclaw_root="$(dirname "$openclaw_real")"

if [ ! -d "$openclaw_root/node_modules/yaml" ]; then
  echo '{"valid":false,"errors":[{"code":"ENVIRONMENT","path":"$","message":"OpenClaw YAML runtime is unavailable"}]}' >&2
  exit 2
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_PATH="$openclaw_root/node_modules${NODE_PATH:+:$NODE_PATH}" exec node "$script_dir/validate_state_machine_yaml.cjs" "$@"
