{
  "name": "openclaw-process-message-plugin",
  "version": "0.0.0",
  "description": "Installable OpenClaw plugin package for message processing and persisted-history rewriting.",
  "repository": {
    "type": "git",
    "url": "https://example.com/ocb/openclaw-plugins"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "openclaw.plugin.json"
  ],
  "type": "module",
  "peerDependencies": {
    "openclaw": "2026.3.12"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run prepublishOnly",
    "lint": "eslint src test --ext .ts",
    "pretest": "npm run lint -- --fix && npm run prepublishOnly",
    "test": "npm run test-local",
    "test-local": "egg-bin test",
    "cov": "egg-bin cov",
    "preci": "npm run prepublishOnly",
    "ci": "npm run lint && npm run cov && attw --pack",
    "prepublishOnly": "tshy && tshy-after"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.15.3",
    "@eggjs/tsconfig": "^1.3.3",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.6.3",
    "egg-bin": "^6.5.2",
    "eslint": "^8.49.0",
    "eslint-config-egg": "^14.0.0",
    "tshy": "^1.1.1",
    "tshy-after": "^1.0.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "install-node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ci": {
    "versions": "20, 22",
    "cr": true
  },
  "yuyanId": "180020010101339038",
  "openclaw": {
    "extensions": [
      "./dist/esm/index.js"
    ]
  },
  "tshy": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "source": "./src/index.ts",
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "source": "./src/index.ts",
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "types": "./dist/commonjs/index.d.ts",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js"
}
