{
  "openapi": "3.1.0",
  "info": {
    "title": "backend",
    "version": "1.0"
  },
  "paths": {
    "/openapi/v1/bots": {
      "get": {
        "operationId": "list_bots",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BotList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_bot",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BotCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/openapi/v1/bots/{id}": {
      "get": {
        "operationId": "get_bot",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bot"
                }
              }
            }
          }
        }
      }
    },
    "/api/internal/debug": {
      "get": {
        "operationId": "debug",
        "responses": {}
      }
    }
  },
  "components": {
    "schemas": {
      "Bot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "BotList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Bot"
            }
          }
        }
      },
      "BotCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "Unused": {
        "type": "object"
      },
      "BotAuthorizationDTO": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State"
          },
          "iframe_url": {
            "type": "string",
            "title": "Iframe Url"
          },
          "redirect_url": {
            "type": "string",
            "title": "Redirect Url"
          },
          "deadline": {
            "type": "string",
            "title": "Deadline"
          },
          "application_id": {
            "type": "string",
            "title": "Application Id"
          }
        },
        "type": "object",
        "required": [
          "state",
          "iframe_url",
          "redirect_url",
          "deadline",
          "application_id"
        ],
        "title": "BotAuthorizationDTO",
        "description": "Pending human-authorization gate for one agent's bot (additive).\n\nPresent on an agent exactly while its bot sits at the human gate\n(``state=AWAITING_AUTHORIZATION``): ``iframe_url``/``redirect_url``\nare the tcauthmng consent surfaces, ``deadline`` the window horizon as\nthe ISO-8601 spelling the creation-job payload itself carries —\nempty strings when the payload cannot answer a fact.\n``application_id`` is the passport application's identifier so a\nconsumer can address the decision surface from this read alone."
      },
      "AgentDetailDTO": {
        "properties": {
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
