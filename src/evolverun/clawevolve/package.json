{
  "name": "@avernet/clawevolve",
  "version": "0.1.0",
  "description": "Public ClawEvolve core for Avernet",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/create-module": {
      "types": "./dist/server/create-module.d.ts",
      "import": "./dist/server/create-module.js"
    },
    "./server/routes/evolve": {
      "types": "./dist/server/routes/evolve.d.ts",
      "import": "./dist/server/routes/evolve.js"
    },
    "./server/services/evolve/command": {
      "types": "./dist/server/services/evolve/command.d.ts",
      "import": "./dist/server/services/evolve/command.js"
    },
    "./server/services/evolve/task-registry": {
      "types": "./dist/server/services/evolve/task-registry.d.ts",
      "import": "./dist/server/services/evolve/task-registry.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "bash scripts/check-public-boundary.sh && tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "express": "^5.2.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  },
  "peerDependencies": {
    "express": "^5.2.1"
  }
}
