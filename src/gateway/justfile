#!/usr/bin/env just --justfile

set dotenv-load := true
set positional-arguments := true

import 'justfiles/ctrl-gateway.just'

import 'justfiles/lint.just'
import 'justfiles/test-common.just'
import 'justfiles/test-self.just'
import 'justfiles/test-ut.just'
import 'justfiles/test-it.just'
import 'justfiles/test-arch.just'
import 'justfiles/test-e2e.just'

_default:
    @just --list --list-prefix '==> '

test-e2e-one test:
    source scripts/lib/test-stages.sh && run_one_e2e_test "{{test}}"

test-ci group='ci' mode='bare' overlay='e2e-sqlite':
    ./scripts/ci_test.sh --group {{group}} {{mode}} {{overlay}}

test mode='bare' overlay='e2e-sqlite':
    #!/usr/bin/env bash
    set -euo pipefail
    # Delegate to ci_test.sh so `just test` enforces the same changed-line
    # coverage gate as GitHub CI (threshold 90). ci_test.sh reuses
    # run_ci_pipeline for the pytest+coverage pass and adds report_check.py
    # with --base, so local and CI describe the same change range.
    repo_root="$(cd "{{ justfile_directory() }}/../.." && pwd)"
    # shellcheck source=scripts/lib/resolve_base_ref.sh
    source "$repo_root/scripts/lib/resolve_base_ref.sh"
    base="$(resolve_base_ref)"
    ./scripts/ci_test.sh --base "$base"

test-full:
    source scripts/lib/test-stages.sh && run_e2e_tests bare e2e-sqlite
    source scripts/lib/test-stages.sh && run_e2e_tests bare e2e-zdas

serve-docs port='8910':
    @./docs/openapi/serve-docs.sh {{port}}

dump-openapi *args='':
    ./scripts/dump_and_publish.sh {{args}}