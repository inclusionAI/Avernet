      "target_bot_uuid": "20260514_adan6ap1:461514",
      "target_bot_id": "20260514_adan6ap1:461514",
      "target_bot_name": "下游评审bot"
    }
  ],
  "default_action": {
    "type": "reject",
    "message": "该活动对应的buName暂无对应bot"
  }
}