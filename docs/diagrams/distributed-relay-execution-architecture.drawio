          <mxGeometry x="1450" y="1430" width="560" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="resume_c" value="恢复 / 终止&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;turn expired → resume_relay_turn → [RESUME_RELAY]&lt;br&gt;不重做已完成业务工作&lt;br&gt;max rounds / resume exhausted → HUNG&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#F4CCCC;strokeColor=#C00000;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2050" y="1430" width="580" height="210" as="geometry"/>
