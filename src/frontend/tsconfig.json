{
  "extends": "./src/.umi/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react",
    "noUnusedLocals": true,
    "paths": {
      "@/*": ["src/*"],
      "@@/*": ["src/.umi/*"]
    }
  },
  "exclude": ["node_modules", "dist", "src/.umi/*"],
  "include": ["mock/**/*", "src/**/*", "test/**/*", "config/**/*"]
}
