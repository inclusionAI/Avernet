        <mxCell id="graph" value="统一任务图谱 · TaskGraphService" style="swimlane;startSize=40;rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;swimlaneFillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
