{
  "name": "open-claw",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/open-claw/open-claw"
  },
  "author": "OpenClaw Team",
  "scripts": {
    "build": "cross-env UMI_ENV=internal max build",
    "build-desk": "cross-env UMI_ENV=internal OUTPUT_PATH=dist/static PUBLIC_PATH=/static/ max build && npm run move-index-to-root",
    "build:oss": "max build",
    "build:webview": "cross-env UMI_ENV=internal BUILD_TARGET=webview max build",
    "ci": "max lint",
    "dev": "cross-env UMI_ENV=internal PRESET=dev max dev",
    "devs": "cross-env UMI_ENV=internal MOCKS=none max dev",
    "devs:dev": "cross-env UMI_ENV=internal MOCKS=none PRESET=dev max dev",
    "devs:local": "cross-env UMI_ENV=internal MOCKS=none PRESET=local max dev",
    "devs:local:oss": "cross-env MOCKS=none PRESET=local max dev",
    "devs:pre": "cross-env UMI_ENV=internal MOCKS=none PRESET=pre max dev",
    "devs:pre:harness": "cross-env UMI_ENV=internal LOCAL_HARNESS=1 MOCKS=none PRESET=pre max dev",
    "devs:pre:oss": "cross-env MOCKS=none PRESET=pre max dev",
    "devs:prod": "cross-env UMI_ENV=internal PRESET=prod max dev",
    "format": "prettier --cache --write .",
    "postinstall": "max setup",
    "lint": "max lint",
    "lint:fix": "max lint --fix",
    "move-index-to-root": "node -e \"const fs=require('fs'); const path=require('path'); const src='dist/static/index.html'; const dest='dist/index.html'; if(fs.existsSync(src)){ fs.copyFileSync(src, dest); console.log('✓ Copied index.html to dist root'); } else { console.error('✗ index.html not found'); process.exit(1); }\"",
    "oneapi": "npm run oneapi:service && npm run oneapi:mock",
    "oneapi:mock": "bigfish api generate mock",
    "oneapi:service": "bigfish api generate service",
    "prepare": "husky install",
    "setup": "max setup",
    "start": "npm run dev",
    "start:local": "npm run dev:local",
    "start:pre": "npm run dev:pre",
    "start:prod": "npm run dev:prod",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@aix-chat/adapters": "^0.1.4",
    "@aix-chat/core": "^0.1.4",
    "@aix-chat/ui": "^0.1.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/view": "^6.42.1",
    "@dicebear/bottts": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/qrcode": "^1.5.6",
    "@uiw/react-codemirror": "^4.25.8",
    "@uiw/react-md-editor": "^4.0.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.11.0",
    "antd": "^5.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.4",
    "echarts": "^6.1.0",
    "i": "^0.3.7",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.11.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.5",
    "react-window": "^1.8.11",
    "react-window-infinite-loader": "^1.0.10",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@stagewise/toolbar": "file:./stubs/stagewise-toolbar",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jest": "^30.0.0",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^11.0.0",
    "@umijs/max": "^4.6.61",
    "autoprefixer": "^10.4.24",
    "cross-env": "^7.0.3",
    "husky": "^8.0.1",
    "jest": "^30.3.0",
    "lint-staged": "^13.0.3",
    "postcss": "^8.5.6",
    "prettier": "^2.7.1",
    "react-refresh": "^0.18.0",
    "tailwindcss": "^3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^4.1.2"
  },
  "optionalDependencies": {
    "node-bin-darwin-arm64": "20",
    "node-darwin-x64": "20",
    "node-linux-arm64": "20",
    "node-linux-x64": "20",
    "node-win-x64": "20",
    "node-win-x86": "20"
  },
  "engines": {
    "install-node": "20"
  },
  "overrides": {
    "react": {
      ".": "18.3.1"
    },
    "react-dom": {
      ".": "18.3.1"
    }
  },
  "_resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
