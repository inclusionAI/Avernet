        <mxCell id="recognize" value="② 任务识别 + 澄清卡片&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;goal / deliverables / acceptances / constraints&lt;br&gt;title / background / resources（可选）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;fillColor=#D9EAF7;strokeColor=#4F81BD;strokeWidth=2;fontStyle=1;" vertex="1" parent="intake">
          <mxGeometry x="390" y="45" width="520" height="110" as="geometry"/>
